<?xml version="1.0" encoding="utf-8" ?>
<views:TabView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Phantom.Views"
             xmlns:controls="clr-namespace:Phantom.Controls"
             xmlns:vm="clr-namespace:Phantom.ViewModels"
             xmlns:dto="clr-namespace:Phantom.Shared;assembly=Phantom.Shared"
             x:Class="Phantom.Views.HomePage"
             x:DataType="vm:HomeViewModel">
    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
        <!-- A CollectionView, not a ScrollView of rows: only the rows on screen are made, so posters further down load
             as they're scrolled to rather than all at once. -->
        <CollectionView ItemsSource="{Binding Hubs}" SelectionMode="None">
            <CollectionView.Header>
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="Auto,*" Padding="16,18,16,4" ColumnSpacing="10">
                    <Image Source="logo_mark.png" HeightRequest="36" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="Discover" Style="{StaticResource H1}" />
                        <Label Text="{Binding Greeting}" Style="{StaticResource Muted}" FontSize="13" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Offline with rows from before still showing: a banner over them (with nothing to show, the empty view
                     below says it instead) -->
                <Border Style="{StaticResource Card}" Margin="16,8">
                    <Border.IsVisible>
                        <MultiBinding Converter="{StaticResource AllTrue}">
                            <Binding Path="IsOffline" />
                            <Binding Path="Hubs.Count" Converter="{StaticResource HasValue}" />
                        </MultiBinding>
                    </Border.IsVisible>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="You're offline. Your downloads are still available." VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Downloads" Command="{Binding GoToDownloadsCommand}" />
                    </Grid>
                </Border>

                <!-- Featured hero: continue watching or newest addition. Its height follows its width (about 16:9, see
                     HomePage.OnHeroSizeChanged) so a backdrop isn't cut down to a strip on a wide screen. -->
                <Border x:Name="Hero" Margin="16,8" StrokeShape="RoundRectangle 16" HeightRequest="220" SizeChanged="OnHeroSizeChanged"
                        IsVisible="{Binding Featured, Converter={StaticResource HasValue}}" BackgroundColor="{StaticResource Surface}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenMovieCommand}" CommandParameter="{Binding Featured}" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Image Source="{Binding Featured.BackdropUrl, Converter={StaticResource Backdrop}}" Aspect="AspectFill" Opacity="0.85"
                               IsVisible="{Binding Featured.BackdropUrl, Converter={StaticResource HasValue}}" />
                        <!-- No backdrop: the poster dimmed behind, and sharp at its own shape beside the title rather than
                             stretched across (which blurred it) -->
                        <Image Source="{Binding Featured.PosterUrl, Converter={StaticResource Poster}}" Aspect="AspectFill" Opacity="0.25"
                               IsVisible="{Binding Featured.BackdropUrl, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                        <Grid Background="{StaticResource BackdropFade}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Padding="18">
                            <Border StrokeShape="RoundRectangle 10" VerticalOptions="End" WidthRequest="{Binding Source={x:Reference Hero}, Path=Height, Converter={StaticResource PosterWidth}}"
                                    IsVisible="{Binding Featured.BackdropUrl, Converter={StaticResource HasValue}, ConverterParameter=invert}">
                                <Image Source="{Binding Featured.PosterUrl, Converter={StaticResource Poster}}" Aspect="AspectFill" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="End" Spacing="6">
                                <Label Text="FEATURED" FontSize="11" TextColor="{StaticResource Accent}" CharacterSpacing="2" />
                                <Label Text="{Binding Featured.Title}" Style="{StaticResource H1}" MaxLines="2" />
                                <Label Style="{StaticResource Muted}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Featured.Year}" />
                                            <Span Text="{Binding Featured.Caption, StringFormat='  ·  {0}'}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <ProgressBar Progress="{Binding Featured.ProgressPercent, Converter={StaticResource Percent}}"
                                             IsVisible="{Binding Featured.ProgressPercent, Converter={StaticResource HasValue}}" WidthRequest="160" HorizontalOptions="Start" />
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </Border>

                <!-- No rows yet: rows of posters loading, offline, or nothing in the library yet. In the header rather than
                     the list's EmptyView, which Windows never shows for a list with a footer. -->
                <controls:StateView Skeleton="Rows" HasContent="{Binding Hubs.Count, Converter={StaticResource HasValue}}"
                                    IsLoading="{Binding IsBusy}" HasLoaded="{Binding HasLoaded}" IsOffline="{Binding IsOffline}"
                                    RetryCommand="{Binding RefreshCommand}" Margin="0,24,0,0"
                                    Glyph="movie_filter" Title="Your library is empty"
                                    Message="Movies and shows show up here as soon as your server finds them. Check back in a little while." />
            </VerticalStackLayout>
            </CollectionView.Header>

            <!-- Hubs -->
            <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:HubDto">
                            <VerticalStackLayout Spacing="8" Padding="0,14,0,0">
                                <Grid ColumnDefinitions="*,Auto" Padding="16,0,8,0">
                                    <Label Text="{Binding Title}" Style="{StaticResource H2}" VerticalOptions="Center" />
                                    <!-- Rows picked for the profile (For You, Popular Now, Because You Watched) are the whole list -->
                                    <Button Grid.Column="1" Text="See all ›" Style="{StaticResource GhostButton}"
                                            IsVisible="{Binding Key, Converter={StaticResource HasSeeAll}}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=SeeAllCommand, x:DataType=vm:HomeViewModel}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                                <CollectionView ItemsSource="{Binding Items}" HeightRequest="{OnIdiom Default=236, TV=250}" SelectionMode="Single" ItemSizingStrategy="MeasureFirstItem"
                                                ItemTemplate="{StaticResource PosterCard}"
                                                SelectionChangedCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=OpenMovieCommand, x:DataType=vm:HomeViewModel}"
                                                SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}, x:DataType=CollectionView}"
                                                SelectionChanged="OnSelectionChanged">
                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.Header>
                                        <BoxView WidthRequest="4" Color="Transparent" />
                                    </CollectionView.Header>
                                </CollectionView>
                            </VerticalStackLayout>
                        </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <BoxView HeightRequest="108" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>
    </RefreshView>
</views:TabView>
