<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Phantom.ViewModels"
             xmlns:controls="clr-namespace:Phantom.Controls"
             xmlns:dto="clr-namespace:Phantom.Shared;assembly=Phantom.Shared"
             xmlns:skeleton="clr-namespace:AppSkeleton;assembly=AppSkeleton"
             x:Class="Phantom.Views.AdminPage"
             x:DataType="vm:AdminViewModel"
             Title="Manage server">
    <ContentPage.Resources>
        <!-- A workflow run on the Deployments tab: running ones with their progress and jobs, finished ones with how they went -->
        <DataTemplate x:Key="DeploymentRun" x:DataType="vm:DeploymentRunRow">
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout>
                            <skeleton:CLabel Text="{Binding Title}" FontFamily="OpenSansSemibold" />
                            <skeleton:CLabel Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" />
                        </VerticalStackLayout>
                        <skeleton:CLabel Grid.Column="1" Text="{Binding Status}" TextColor="{Binding StatusColor}" FontFamily="OpenSansSemibold" FontSize="12"
                                         VerticalOptions="Center" />
                    </Grid>
                    <ProgressBar Progress="{Binding Progress}" IsVisible="{Binding IsRunning}" />
                    <skeleton:CLabel Text="{Binding ProgressText}" Style="{StaticResource Muted}" FontSize="12" IsVisible="{Binding ProgressText, Converter={StaticResource HasValue}}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Jobs}" Spacing="6" IsVisible="{Binding Jobs, Converter={StaticResource HasValue}}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:DeploymentJobRow">
                                <Grid ColumnDefinitions="22,*,Auto" ColumnSpacing="8">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}, Path=OpenOnGitHubCommand, x:DataType=vm:AdminViewModel}"
                                                              CommandParameter="{Binding Url}" />
                                    </Grid.GestureRecognizers>
                                    <skeleton:CLabel Text="{Binding Icon}" TextColor="{Binding IconColor}" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <skeleton:CLabel Text="{Binding Name}" FontSize="14" LineBreakMode="TailTruncation" />
                                        <skeleton:CLabel Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <ProgressBar Grid.Column="2" WidthRequest="70" VerticalOptions="Center" Progress="{Binding Progress}" IsVisible="{Binding IsRunning}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <FlexLayout Wrap="Wrap" Margin="-4,0">
                        <Button Text="Open on GitHub" Style="{StaticResource GhostButton}" Margin="4"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}, Path=OpenOnGitHubCommand, x:DataType=vm:AdminViewModel}"
                                CommandParameter="{Binding Url}" />
                        <Button Text="Cancel" Style="{StaticResource GhostButton}" TextColor="{StaticResource Danger}" Margin="4" IsVisible="{Binding IsRunning}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}, Path=CancelRunCommand, x:DataType=vm:AdminViewModel}"
                                CommandParameter="{Binding .}" />
                        <Button Text="Run again" Style="{StaticResource GhostButton}" Margin="4" IsVisible="{Binding CanRerun}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}, Path=RerunCommand, x:DataType=vm:AdminViewModel}"
                                CommandParameter="{Binding .}" />
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>
    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">
                <controls:TabStrip Tabs="{Binding Tabs}" SelectedIndex="{Binding SelectedTab}" Margin="-16,0" />

                <VerticalStackLayout Spacing="14" IsVisible="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=0}">
                <!-- Status -->
                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" RowSpacing="2">
                        <skeleton:CLabel Text="{Binding Info.MovieCount}" Style="{StaticResource H1}" HorizontalOptions="Center" />
                        <skeleton:CLabel Grid.Row="1" Text="Movies" Style="{StaticResource Muted}" HorizontalOptions="Center" />
                        <skeleton:CLabel Grid.Column="1" Text="{Binding Info.ActiveTorrents}" Style="{StaticResource H1}" HorizontalOptions="Center" />
                        <skeleton:CLabel Grid.Column="1" Grid.Row="1" Text="Active torrents" Style="{StaticResource Muted}" HorizontalOptions="Center" />
                        <skeleton:CLabel Grid.Column="2" Text="{Binding Info.FreeDiskBytes, Converter={StaticResource Bytes}}" Style="{StaticResource H2}" HorizontalOptions="Center" VerticalOptions="Center" />
                        <skeleton:CLabel Grid.Column="2" Grid.Row="1" Text="Free disk" Style="{StaticResource Muted}" HorizontalOptions="Center" />
                    </Grid>
                </Border>
                <skeleton:CLabel Style="{StaticResource Muted}" FontSize="12">
                    <skeleton:CLabel.FormattedText>
                        <FormattedString>
                            <Span Text="Downloading " />
                            <Span Text="{Binding Info.DownloadRate, Converter={StaticResource Bytes}, ConverterParameter=rate}" />
                            <Span Text="   ·   Uploading " />
                            <Span Text="{Binding Info.UploadRate, Converter={StaticResource Bytes}, ConverterParameter=rate}" />
                            <Span Text="&#10;" />
                            <Span Text="{Binding FeaturesText}" />
                        </FormattedString>
                    </skeleton:CLabel.FormattedText>
                </skeleton:CLabel>

                <!-- Now playing -->
                <Grid ColumnDefinitions="*,Auto">
                    <skeleton:CLabel Text="Now playing" Style="{StaticResource H2}" VerticalOptions="Center" />
                    <ImageButton Grid.Column="1" Style="{StaticResource IconButton}" Source="{controls:Icon refresh}" Command="{Binding RefreshActivityCommand}"
                                 SemanticProperties.Description="Refresh" ToolTipProperties.Text="Refresh" />
                </Grid>
                <skeleton:CLabel Text="Nobody is watching right now." Style="{StaticResource Muted}" IsVisible="{Binding Sessions.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sessions}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dto:NowPlayingDto">
                            <Border Style="{StaticResource Card}" Padding="10">
                                <Grid ColumnDefinitions="44,*" ColumnSpacing="10">
                                    <Border StrokeShape="RoundRectangle 4" HeightRequest="64">
                                        <Image Source="{Binding PosterUrl, Converter={StaticResource Poster}}" Aspect="AspectFill" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <skeleton:CLabel Text="{Binding MovieTitle}" FontFamily="OpenSansSemibold" />
                                        <skeleton:CLabel Style="{StaticResource Muted}" FontSize="12">
                                            <skeleton:CLabel.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Username}" />
                                                    <Span Text=" on " />
                                                    <Span Text="{Binding ClientName}" />
                                                    <Span Text="  ·  " />
                                                    <Span Text="{Binding State}" />
                                                    <Span Text="  ·  " />
                                                    <Span Text="{Binding PositionMs, Converter={StaticResource Time}}" />
                                                </FormattedString>
                                            </skeleton:CLabel.FormattedText>
                                        </skeleton:CLabel>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                </VerticalStackLayout>

                <VerticalStackLayout Spacing="14" IsVisible="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=1}">
                <!-- Sources -->
                <Grid ColumnDefinitions="*,Auto">
                    <skeleton:CLabel Text="Sources" Style="{StaticResource H2}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Check all now" Style="{StaticResource GhostButton}" Command="{Binding SyncAllCommand}"
                            ImageSource="{controls:Icon sync, Color={StaticResource PrimaryLight}, Size=20}" ContentLayout="Left,6" />
                </Grid>
                <skeleton:CLabel Text="The sources Phantom checks for new movies, on a schedule. They are built in; turn one off to stop checking it."
                       Style="{StaticResource Muted}" FontSize="12" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sources}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dto:SourceDto">
                            <Border Style="{StaticResource Card}">
                                <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="2">
                                    <skeleton:CLabel Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                                    <skeleton:CLabel Grid.Row="1" Style="{StaticResource Muted}" FontSize="12">
                                        <skeleton:CLabel.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Type, Converter={StaticResource SourceType}}" />
                                                <Span Text="  ·  checks " />
                                                <Span Text="{Binding SyncIntervalMinutes, Converter={StaticResource Interval}}" />
                                            </FormattedString>
                                        </skeleton:CLabel.FormattedText>
                                    </skeleton:CLabel>
                                    <VerticalStackLayout Grid.Row="2" Spacing="4" Margin="0,4,0,0">
                                        <!-- Working on it right now -->
                                        <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsSyncing}">
                                            <ActivityIndicator IsRunning="{Binding IsSyncing}" WidthRequest="16" HeightRequest="16" />
                                            <skeleton:CLabel Text="Checking for new titles now…" FontSize="12" TextColor="{StaticResource PrimaryLight}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <!-- The whole-catalogue import, while it's running -->
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding CatalogueProgress, Converter={StaticResource Below100}}">
                                            <ProgressBar Progress="{Binding CatalogueProgress, Converter={StaticResource Percent}}" VerticalOptions="Center" />
                                            <skeleton:CLabel Grid.Column="1" Text="{Binding CatalogueProgress, StringFormat='Catalogue {0:0}% imported'}" Style="{StaticResource Muted}" FontSize="12" />
                                        </Grid>
                                        <!-- How the last check went, and when; hidden while a check runs. In red when it failed.
                                             Selectable, so an error can be copied into a bug report. -->
                                        <skeleton:CLabel Text="{Binding StatusText}" Style="{StaticResource Muted}" FontSize="12"
                                                         IsVisible="{Binding StatusText, Converter={StaticResource HasValue}}">
                                            <skeleton:CLabel.Triggers>
                                                <DataTrigger TargetType="skeleton:CLabel" Binding="{Binding LastSyncFailed}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource Danger}" />
                                                </DataTrigger>
                                            </skeleton:CLabel.Triggers>
                                        </skeleton:CLabel>
                                    </VerticalStackLayout>
                                    <ImageButton Grid.Column="1" Grid.RowSpan="3" Style="{StaticResource IconButton}" VerticalOptions="Center"
                                                 Source="{controls:Icon sync}" SemanticProperties.Description="Check now" ToolTipProperties.Text="Check now"
                                                 Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}, Path=SyncCommand, x:DataType=vm:AdminViewModel}" CommandParameter="{Binding .}" />
                                    <Switch Grid.Column="2" Grid.RowSpan="3" VerticalOptions="Center" IsToggled="{Binding Enabled, Mode=OneWay}" Toggled="OnSourceToggled"
                                            SemanticProperties.Description="On or off" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                </VerticalStackLayout>

                <VerticalStackLayout Spacing="14" IsVisible="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=2}">
                <!-- Accounts -->
                <skeleton:CLabel Text="Everyone signs in with their own account. Each account starts with a default profile named after it, and can add more."
                       Style="{StaticResource Muted}" FontSize="12" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Accounts}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:AccountRow">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" Padding="14,8">
                                    <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 10" BackgroundColor="{Binding Account.AvatarColor}">
                                        <skeleton:CLabel Text="{Binding Account.Username, Converter={StaticResource Initial}}" FontFamily="OpenSansSemibold"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <HorizontalStackLayout Spacing="8">
                                            <skeleton:CLabel Text="{Binding Account.Username}" FontFamily="OpenSansSemibold" />
                                            <skeleton:CLabel Text="Admin" Style="{StaticResource Muted}" FontSize="12" VerticalOptions="Center" IsVisible="{Binding Account.IsAdmin}" />
                                        </HorizontalStackLayout>
                                        <skeleton:CLabel Text="{Binding Profiles, StringFormat='Profiles: {0}'}" Style="{StaticResource Muted}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <ImageButton Grid.Column="2" Style="{StaticResource IconButton}"
                                                 Source="{controls:Icon admin_panel_settings, Outlined=True}" SemanticProperties.Description="Admin on or off" ToolTipProperties.Text="Admin on or off"
                                                 Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}, Path=ToggleAdminCommand, x:DataType=vm:AdminViewModel}" CommandParameter="{Binding .}" />
                                    <ImageButton Grid.Column="3" Style="{StaticResource IconButton}"
                                                 Source="{controls:Icon delete, Outlined=True, Color={StaticResource Danger}}" SemanticProperties.Description="Delete account" ToolTipProperties.Text="Delete account"
                                                 Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}, Path=DeleteAccountCommand, x:DataType=vm:AdminViewModel}" CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
                <Button Text="Add account" Style="{StaticResource SecondaryButton}" Command="{Binding AddAccountCommand}"
                        ImageSource="{controls:Icon person_add, Size=20}" ContentLayout="Left,6" />

                </VerticalStackLayout>

                <VerticalStackLayout Spacing="14" IsVisible="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=3}">
                <!-- Settings -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <skeleton:CLabel Text="Server name" Style="{StaticResource Muted}" />
                        <Entry Text="{Binding ServerName}" />
                        <skeleton:CLabel Text="Preferred quality for new streams" Style="{StaticResource Muted}" />
                        <Picker ItemsSource="{Binding QualityChoices}" SelectedItem="{Binding PreferredQuality}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                            <skeleton:CLabel Text="Max active downloads" Style="{StaticResource Muted}" />
                            <skeleton:CLabel Grid.Column="1" Text="Min seeders to import" Style="{StaticResource Muted}" />
                            <Entry Grid.Row="1" Text="{Binding MaxActiveDownloads}" Keyboard="Numeric" />
                            <Entry Grid.Row="1" Grid.Column="1" Text="{Binding MinSeeders}" Keyboard="Numeric" />
                            <skeleton:CLabel Grid.Row="2" Text="Download limit (KB/s, 0 = ∞)" Style="{StaticResource Muted}" />
                            <skeleton:CLabel Grid.Row="2" Grid.Column="1" Text="Upload limit (KB/s, 0 = ∞)" Style="{StaticResource Muted}" />
                            <Entry Grid.Row="3" Text="{Binding MaxDownloadKbps}" Keyboard="Numeric" />
                            <Entry Grid.Row="3" Grid.Column="1" Text="{Binding MaxUploadKbps}" Keyboard="Numeric" />
                        </Grid>
                        <skeleton:CLabel Text="Delete movies saved on the server after (days, 0 = keep them)" Style="{StaticResource Muted}" />
                        <Entry Text="{Binding KeepServerDownloadsDays}" Keyboard="Numeric" />
                        <Grid ColumnDefinitions="*,Auto">
                            <skeleton:CLabel Text="Seed after downloading" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding SeedAfterDownload}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <skeleton:CLabel Text="Auto-download newly found movies" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding AutoDownloadNewReleases}" />
                        </Grid>
                        <Button Text="Save settings" Command="{Binding SaveSettingsCommand}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <skeleton:CLabel Text="Metadata" Style="{StaticResource H2}" />
                        <skeleton:CLabel Text="{Binding MetadataText}" Style="{StaticResource Muted}" />
                        <Button Text="Refresh all metadata now" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshAllMetadataCommand}"
                                ImageSource="{controls:Icon sync, Size=20}" ContentLayout="Left,6" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="14" IsVisible="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=4}">
                <!-- Storage: the disk, what's using it, and each torrent's files -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <skeleton:CLabel Text="Disk" Style="{StaticResource H2}" VerticalOptions="Center" />
                            <ImageButton Grid.Column="1" Style="{StaticResource IconButton}" Source="{controls:Icon refresh}" Command="{Binding RefreshStorageCommand}"
                                         SemanticProperties.Description="Refresh" ToolTipProperties.Text="Refresh" />
                        </Grid>
                        <skeleton:CLabel Text="{Binding DiskText}" FontFamily="OpenSansSemibold" />
                        <ProgressBar Progress="{Binding DiskUsed}">
                            <ProgressBar.Triggers>
                                <DataTrigger TargetType="ProgressBar" Binding="{Binding DiskLow}" Value="True">
                                    <Setter Property="ProgressColor" Value="{StaticResource Danger}" />
                                </DataTrigger>
                            </ProgressBar.Triggers>
                        </ProgressBar>
                        <skeleton:CLabel Text="{Binding BreakdownText}" Style="{StaticResource Muted}" LineHeight="1.3" />
                        <FlexLayout Wrap="Wrap" Margin="-4,4,-4,0">
                            <!-- Only while there's some left from when torrents were streamed (the server clears it by itself too) -->
                            <Button Text="Clear leftover stream cache" Style="{StaticResource SecondaryButton}" Command="{Binding ClearIdleCachesCommand}" Margin="4"
                                    ImageSource="{controls:Icon delete_sweep, Size=20}" ContentLayout="Left,6" IsVisible="{Binding HasStreamCache}" />
                            <Button Text="Clear seek previews" Style="{StaticResource SecondaryButton}" Command="{Binding ClearPreviewsCommand}" Margin="4"
                                    ImageSource="{controls:Icon image_not_supported, Size=20}" ContentLayout="Left,6" />
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>

                <skeleton:CLabel Text="Largest first. Saved copies are kept until they're removed or expire; anything else is left over from when torrents were streamed, and is cleared by itself."
                       Style="{StaticResource Muted}" FontSize="12" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding StoredItems}" Spacing="8">
                    <BindableLayout.EmptyView>
                        <skeleton:CLabel Text="Nothing stored yet." Style="{StaticResource Muted}" HorizontalOptions="Center" Margin="0,16" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dto:StoredTorrentDto">
                            <Border Style="{StaticResource Card}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                        <skeleton:CLabel Text="{Binding Title}" FontFamily="OpenSansSemibold" LineBreakMode="TailTruncation" MaxLines="2" />
                                        <skeleton:CLabel Style="{StaticResource Muted}" FontSize="12">
                                            <skeleton:CLabel.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding SizeBytes, Converter={StaticResource Bytes}}" />
                                                    <Span Text="  ·  " />
                                                    <Span Text="{Binding KindText}" />
                                                </FormattedString>
                                            </skeleton:CLabel.FormattedText>
                                        </skeleton:CLabel>
                                        <skeleton:CLabel Text="Being watched" FontSize="12" TextColor="{StaticResource PrimaryLight}" IsVisible="{Binding InUse}" />
                                    </VerticalStackLayout>
                                    <ImageButton Grid.Column="1" Style="{StaticResource IconButton}" Source="{controls:Icon delete, Outlined=True}" VerticalOptions="Center"
                                                 IsVisible="{Binding InUse, Converter={StaticResource Not}}"
                                                 Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}, Path=RemoveStoredCommand, x:DataType=vm:AdminViewModel}"
                                                 CommandParameter="{Binding .}"
                                                 SemanticProperties.Description="Delete" ToolTipProperties.Text="Delete" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="14" IsVisible="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=5}">
                <!-- Deployments: the repository's GitHub Actions. Running anything makes the repository public; the server makes
                     it private again when the last run has finished. -->
                <skeleton:CLabel Text="{Binding DeploymentsError}" Style="{StaticResource Muted}" IsVisible="{Binding DeploymentsError, Converter={StaticResource HasValue}}" />

                <VerticalStackLayout Spacing="14" IsVisible="{Binding Repository, Converter={StaticResource HasValue}}">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <VerticalStackLayout VerticalOptions="Center">
                                <skeleton:CLabel Text="Repository" Style="{StaticResource H2}" />
                                <skeleton:CLabel Text="{Binding RepositoryText}" Style="{StaticResource Muted}" FontSize="12" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{Binding VisibilityColor}" Padding="10,3" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="4">
                                    <Image Source="{controls:Icon lock, Color={StaticResource Success}, Size=14}" WidthRequest="14" HeightRequest="14" VerticalOptions="Center"
                                           IsVisible="{Binding Repository.IsPrivate}" />
                                    <Image Source="{controls:Icon public, Color={StaticResource Warning}, Size=14}" WidthRequest="14" HeightRequest="14" VerticalOptions="Center"
                                           IsVisible="{Binding Repository.IsPrivate, Converter={StaticResource Not}}" />
                                    <skeleton:CLabel Text="{Binding VisibilityText}" TextColor="{Binding VisibilityColor}" FontFamily="OpenSansSemibold" FontSize="12" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                            <ImageButton Grid.Column="2" Style="{StaticResource IconButton}" Source="{controls:Icon refresh}" Command="{Binding RefreshDeploymentsCommand}"
                                         SemanticProperties.Description="Refresh" ToolTipProperties.Text="Refresh" />
                        </Grid>
                        <skeleton:CLabel Text="{Binding KeeperText}" Style="{StaticResource Muted}" FontSize="12">
                            <skeleton:CLabel.Triggers>
                                <DataTrigger TargetType="skeleton:CLabel" Binding="{Binding KeeperFailed}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource Danger}" />
                                </DataTrigger>
                            </skeleton:CLabel.Triggers>
                        </skeleton:CLabel>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" RowSpacing="2">
                        <skeleton:CLabel Text="{Binding UnpublishedCount}" Style="{StaticResource H1}" HorizontalOptions="Center" />
                        <skeleton:CLabel Grid.Row="1" Text="{Binding UnpublishedNote}" Style="{StaticResource Muted}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        <skeleton:CLabel Grid.Column="1" Text="{Binding FilesChanged}" Style="{StaticResource H1}" HorizontalOptions="Center" />
                        <skeleton:CLabel Grid.Column="1" Grid.Row="1" Text="{Binding LinesChanged}" Style="{StaticResource Muted}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        <skeleton:CLabel Grid.Column="2" Text="{Binding PublishedVersion}" Style="{StaticResource H2}" HorizontalOptions="Center" VerticalOptions="Center" />
                        <skeleton:CLabel Grid.Column="2" Grid.Row="1" Text="{Binding PublishedWhen}" Style="{StaticResource Muted}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Running now -->
                <skeleton:CLabel Text="Running now" Style="{StaticResource H2}" IsVisible="{Binding RunningRuns.Count, Converter={StaticResource HasValue}}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding RunningRuns}" BindableLayout.ItemTemplate="{StaticResource DeploymentRun}" Spacing="8" />

                <!-- Waiting to be published -->
                <skeleton:CLabel Text="Waiting to be published" Style="{StaticResource H2}" />
                <VerticalStackLayout Spacing="2">
                    <skeleton:CLabel Text="{Binding UnpublishedTitle}" FontFamily="OpenSansSemibold" />
                    <skeleton:CLabel Text="{Binding UnpublishedDetail}" Style="{StaticResource Muted}" FontSize="12" />
                </VerticalStackLayout>
                <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding UnpublishedCommits.Count, Converter={StaticResource HasValue}}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding UnpublishedCommits}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:DeploymentCommitRow">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="14,8" Opacity="{Binding Opacity}">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}, Path=OpenOnGitHubCommand, x:DataType=vm:AdminViewModel}"
                                                              CommandParameter="{Binding Url}" />
                                    </Grid.GestureRecognizers>
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <skeleton:CLabel Text="{Binding Message}" FontSize="14" LineBreakMode="TailTruncation" MaxLines="2" />
                                        <skeleton:CLabel Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <skeleton:CLabel Grid.Column="1" Text="Published" TextColor="{StaticResource Success}" FontFamily="OpenSansSemibold" FontSize="12"
                                                     VerticalOptions="Center" IsVisible="{Binding IsRelease}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
                <Button Text="Compare on GitHub" Style="{StaticResource SecondaryButton}" HorizontalOptions="Start"
                        Command="{Binding OpenOnGitHubCommand}" CommandParameter="{Binding CompareUrl}" IsVisible="{Binding CompareUrl, Converter={StaticResource HasValue}}" />

                <!-- Run a workflow: Publish first, with its options as GitHub's Run workflow form has them -->
                <skeleton:CLabel Text="Run a workflow" Style="{StaticResource H2}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Picker ItemsSource="{Binding RunnableWorkflows}" SelectedItem="{Binding SelectedWorkflow}" ItemDisplayBinding="{Binding Name, x:DataType=dto:WorkflowDto}"
                                Title="Workflow" />
                        <skeleton:CLabel Text="{Binding WorkflowDetail}" Style="{StaticResource Muted}" FontSize="12" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding WorkflowInputs}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:WorkflowInputRow">
                                    <VerticalStackLayout>
                                        <VerticalStackLayout IsVisible="{Binding IsSection}" Margin="0,8,0,0">
                                            <skeleton:CLabel Text="{Binding Label}" FontFamily="OpenSansSemibold" />
                                            <skeleton:CLabel Text="{Binding Note}" Style="{StaticResource Muted}" FontSize="12" />
                                        </VerticalStackLayout>
                                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsBoolean}">
                                            <skeleton:CLabel Text="{Binding Label}" VerticalOptions="Center" />
                                            <Switch Grid.Column="1" IsToggled="{Binding IsChecked}" />
                                        </Grid>
                                        <VerticalStackLayout IsVisible="{Binding IsChoice}" Spacing="2">
                                            <skeleton:CLabel Text="{Binding Label}" Style="{StaticResource Muted}" />
                                            <Picker ItemsSource="{Binding Options}" SelectedItem="{Binding Value}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout IsVisible="{Binding IsText}" Spacing="2">
                                            <skeleton:CLabel Text="{Binding Label}" Style="{StaticResource Muted}" />
                                            <Entry Text="{Binding Value}" Keyboard="{Binding Keyboard}" />
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Button Text="{Binding RunWorkflowText}" Command="{Binding RunWorkflowCommand}" IsEnabled="{Binding SelectedWorkflow, Converter={StaticResource HasValue}}"
                                ImageSource="{controls:Icon rocket_launch, Size=20}" ContentLayout="Left,6" />
                    </VerticalStackLayout>
                </Border>

                <!-- Recent runs -->
                <skeleton:CLabel Text="Recent runs" Style="{StaticResource H2}" IsVisible="{Binding RecentRuns.Count, Converter={StaticResource HasValue}}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentRuns}" BindableLayout.ItemTemplate="{StaticResource DeploymentRun}" Spacing="8" />
                </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
