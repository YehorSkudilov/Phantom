<?xml version="1.0" encoding="utf-8" ?>
<views:TabView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Phantom.Controls"
             xmlns:views="clr-namespace:Phantom.Views"
             xmlns:parts="clr-namespace:Phantom.Views.Parts"
             xmlns:vm="clr-namespace:Phantom.ViewModels"
             xmlns:svc="clr-namespace:Phantom.Services"
             x:Class="Phantom.Views.DownloadsPage"
             x:DataType="vm:DownloadsViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <Label Text="Downloads" Style="{StaticResource H1}" Margin="16,18,16,4" />
        <controls:TabStrip Grid.Row="1" Tabs="{Binding Tabs}" SelectedIndex="{Binding SelectedTab}" Margin="0,4,0,0" />
        <!-- Search, All / Movies / TV shows, sort and grid or list: one for both tabs -->
        <controls:ListToolbar Grid.Row="2" BindingContext="{Binding Filter}" />

        <!-- On this device -->
        <Grid Grid.Row="3" RowDefinitions="Auto,*" IsVisible="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=1}">
        <Border Style="{StaticResource Card}" Margin="16,4,16,8">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <Label Text="On this device" Style="{StaticResource H2}" />
                <Label Grid.Row="1" Text="{Binding StorageText}" Style="{StaticResource Muted}" />
                <HorizontalStackLayout Grid.Column="1" Grid.RowSpan="2" Spacing="6" VerticalOptions="Center">
                    <Label Text="Wi-Fi only" Style="{StaticResource Muted}" VerticalOptions="Center" />
                    <Switch IsToggled="{Binding WifiOnly}" />
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- A list of cards -->
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}"
                     IsVisible="{Binding Filter.IsGrid, Converter={StaticResource Not}}">
        <CollectionView ItemsSource="{Binding Shown}" SelectionMode="None">
            <CollectionView.Footer>
                <BoxView HeightRequest="{x:Static views:TabView.NavBarInset}" Color="Transparent" />
            </CollectionView.Footer>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="svc:OfflineDownload">
                    <Border Style="{StaticResource Card}" Margin="16,5" Padding="10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadsViewModel}}, Path=OpenCommand, x:DataType=vm:DownloadsViewModel}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="12">
                            <Border StrokeShape="RoundRectangle 6" HeightRequest="84">
                                <Image Source="{Binding PosterSource}" Aspect="AspectFill" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="15" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Subtitle}" FontSize="13" LineBreakMode="TailTruncation"
                                       IsVisible="{Binding Subtitle, Converter={StaticResource HasValue}}" />
                                <Label Text="{Binding StatusText}" FontSize="12" TextColor="{StaticResource PrimaryLight}" />
                                <ProgressBar Progress="{Binding Progress}" IsVisible="{Binding IsComplete, Converter={StaticResource Not}}" Margin="0,2" />
                                <Label Text="{Binding SizeText}" Style="{StaticResource Muted}" FontSize="12"
                                       IsVisible="{Binding SizeText, Converter={StaticResource HasValue}}" />
                                <Label Text="{Binding Error}" TextColor="{StaticResource Danger}" FontSize="11" MaxLines="2"
                                       IsVisible="{Binding Error, Converter={StaticResource HasValue}}" />
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
                                <ImageButton Style="{StaticResource IconButton}" Source="{controls:Icon play_arrow}" IsVisible="{Binding IsComplete}"
                                             SemanticProperties.Description="Play" ToolTipProperties.Text="Play"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadsViewModel}}, Path=PlayCommand, x:DataType=vm:DownloadsViewModel}"
                                             CommandParameter="{Binding .}" />
                                <ImageButton Style="{StaticResource IconButton}" Source="{controls:Icon pause}" IsVisible="{Binding CanPause}"
                                             SemanticProperties.Description="Pause" ToolTipProperties.Text="Pause"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadsViewModel}}, Path=PauseCommand, x:DataType=vm:DownloadsViewModel}"
                                             CommandParameter="{Binding .}" />
                                <ImageButton Style="{StaticResource IconButton}" Source="{controls:Icon download}" IsVisible="{Binding CanResume}"
                                             SemanticProperties.Description="Resume" ToolTipProperties.Text="Resume"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadsViewModel}}, Path=ResumeCommand, x:DataType=vm:DownloadsViewModel}"
                                             CommandParameter="{Binding .}" />
                                <ImageButton Style="{StaticResource IconButton}" Source="{controls:Icon delete, Outlined=True}"
                                             SemanticProperties.Description="Delete from this device" ToolTipProperties.Text="Delete from this device"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadsViewModel}}, Path=DeleteCommand, x:DataType=vm:DownloadsViewModel}"
                                             CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </RefreshView>

        <!-- A grid of posters, like My Library: the part not downloaded yet is greyed, with the status over it -->
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}"
                     IsVisible="{Binding Filter.IsGrid}">
        <CollectionView ItemsSource="{Binding Shown}" SelectionMode="None" Margin="12,0">
            <CollectionView.ItemsLayout>
                <GridItemsLayout x:Name="DeviceGrid" Orientation="Vertical" Span="3" HorizontalItemSpacing="10" VerticalItemSpacing="6" />
            </CollectionView.ItemsLayout>
            <CollectionView.Footer>
                <BoxView HeightRequest="{x:Static views:TabView.NavBarInset}" Color="Transparent" />
            </CollectionView.Footer>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="svc:OfflineDownload">
                    <Grid RowDefinitions="Auto,Auto,Auto" Padding="{OnIdiom Default='0,0,0,8', TV='5,5,5,8'}" RowSpacing="4">
                        <Border StrokeShape="RoundRectangle 8" HeightRequest="165" BackgroundColor="{StaticResource Surface}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadsViewModel}}, Path=ActivateCommand, x:DataType=vm:DownloadsViewModel}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid>
                                <Image Source="{Binding PosterSource}" Aspect="AspectFill" />
                                <!-- Grey over what's still to come: half downloaded, half grey -->
                                <BoxView Color="#C8303038" AnchorX="1" InputTransparent="True"
                                         ScaleX="{Binding Progress, Converter={StaticResource Remaining}}"
                                         IsVisible="{Binding IsComplete, Converter={StaticResource Not}}" />
                                <Border VerticalOptions="End" BackgroundColor="#B3000000" StrokeThickness="0" Padding="6,4" InputTransparent="True"
                                        IsVisible="{Binding IsComplete, Converter={StaticResource Not}}">
                                    <Label Text="{Binding OverlayText}" FontSize="11" TextColor="White" MaxLines="2" LineBreakMode="TailTruncation" />
                                </Border>
                            </Grid>
                        </Border>
                        <HorizontalStackLayout HorizontalOptions="End" VerticalOptions="Start" Margin="0,5,5,0" Spacing="4">
                            <ImageButton Style="{StaticResource CornerButton}" Source="{controls:Icon pause, Color=White}" IsVisible="{Binding CanPause}"
                                         SemanticProperties.Description="Pause" ToolTipProperties.Text="Pause"
                                         Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadsViewModel}}, Path=PauseCommand, x:DataType=vm:DownloadsViewModel}"
                                         CommandParameter="{Binding .}" />
                            <ImageButton Style="{StaticResource CornerButton}" Source="{controls:Icon play_arrow, Color=White}" IsVisible="{Binding CanResume}"
                                         SemanticProperties.Description="Resume" ToolTipProperties.Text="Resume"
                                         Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadsViewModel}}, Path=ResumeCommand, x:DataType=vm:DownloadsViewModel}"
                                         CommandParameter="{Binding .}" />
                            <ImageButton Style="{StaticResource CornerButton}" Source="{controls:Icon delete, Outlined=True, Color=White}"
                                         SemanticProperties.Description="Delete from this device" ToolTipProperties.Text="Delete from this device"
                                         Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadsViewModel}}, Path=DeleteCommand, x:DataType=vm:DownloadsViewModel}"
                                         CommandParameter="{Binding .}" />
                        </HorizontalStackLayout>
                        <Label Grid.Row="1" Text="{Binding Title}" FontSize="13" LineBreakMode="TailTruncation" MaxLines="2" />
                        <Label Grid.Row="2" Style="{StaticResource Muted}" FontSize="12" LineBreakMode="TailTruncation" MaxLines="1"
                               Text="{Binding Subtitle}" IsVisible="{Binding Subtitle, Converter={StaticResource HasValue}}" />
                        <Label Grid.Row="2" Style="{StaticResource Muted}" FontSize="12" LineBreakMode="TailTruncation" MaxLines="1"
                               Text="{Binding SizeText}" IsVisible="{Binding Subtitle, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </RefreshView>
        <!-- Empty state outside the list: on Windows a CollectionView with a footer never shows its EmptyView. -->
        <controls:StateView Grid.Row="1" HasContent="{Binding Items.Count, Converter={StaticResource HasValue}}"
                            Glyph="download_for_offline" Title="No downloads yet"
                            Message="Tap Download on a movie or an episode and it'll play here, even on a plane."
                            ActionText="Find something to watch" ActionCommand="{Binding BrowseCommand}" />
        </Grid>

        <!-- On the server -->
        <parts:ServerDownloadsView Grid.Row="3" BindingContext="{Binding Server}"
                                   IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadsViewModel}}, Path=SelectedTab, Converter={StaticResource Equals}, ConverterParameter=0, x:DataType=vm:DownloadsViewModel}" />
    </Grid>
</views:TabView>
