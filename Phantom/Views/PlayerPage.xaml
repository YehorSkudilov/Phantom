<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Phantom.ViewModels"
             xmlns:controls="clr-namespace:Phantom.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             x:Class="Phantom.Views.PlayerPage"
             x:DataType="vm:PlayerViewModel"
             ios:Page.PrefersStatusBarHidden="True"
             ios:Page.PrefersHomeIndicatorAutoHidden="True"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="Black">
    <!-- The surface and the controls' backdrop tap only to show or hide the controls: the remote skips them (it has
         its own keys for that, see OnRemoteKey). -->
    <Grid controls:RemoteFocus.Skip="True">
        <Grid.GestureRecognizers>
            <!-- Also double-taps on the left or right side, to skip back or forward (see OnSurfaceTapped) -->
            <TapGestureRecognizer Tapped="OnSurfaceTapped" />
        </Grid.GestureRecognizers>

        <toolkit:MediaElement x:Name="Media" ShouldShowPlaybackControls="False" ShouldAutoPlay="True" ShouldKeepScreenOn="True"
                              Aspect="AspectFit" MetadataTitle="{Binding Title}" MetadataArtworkUrl="{Binding PosterUrl}"
                              Speed="{Binding Speed}" />

        <!-- Moving along the timeline (dragging, or the remote, paused): the frame there, over the whole picture. -->
        <Image x:Name="FullPreview" IsVisible="False" Aspect="AspectFit" InputTransparent="True" BackgroundColor="Black" />

        <!-- Subtitles are rendered by Phantom (MediaElement has no subtitle support). -->
        <Label Text="{Binding SubtitleText}" FontSize="{Binding SubtitleSize}" TextColor="White" BackgroundColor="#99000000"
               Padding="10,4" HorizontalOptions="Center" VerticalOptions="End" Margin="24,0,24,96"
               HorizontalTextAlignment="Center" IsVisible="{Binding SubtitleText, Converter={StaticResource HasValue}}" />

        <!-- Casting: the video plays on the TV, and this screen is its remote (see StartCastingAsync). -->
        <Grid x:Name="CastPanel" IsVisible="False" BackgroundColor="Black" InputTransparent="True">
            <Image Source="{Binding PosterUrl}" Aspect="AspectFill" Opacity="0.3" />
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Margin="24,0">
                <Image Source="{controls:Icon cast_connected, Color=White, Size=56}" HorizontalOptions="Center" />
                <Label x:Name="CastStatus" TextColor="White" FontFamily="OpenSansSemibold" FontSize="16" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- Loading: what the server is doing to get the movie playing (see PlayerViewModel.PollStatusAsync). -->
        <Border x:Name="Buffering" HorizontalOptions="Center" VerticalOptions="Center" Padding="24,20" MaximumWidthRequest="420"
                BackgroundColor="#CC0B0B12" StrokeShape="RoundRectangle 16" InputTransparent="True">
            <VerticalStackLayout Spacing="10">
                <ActivityIndicator IsRunning="True" WidthRequest="44" HeightRequest="44" />
                <Label Text="{Binding LoadingText}" TextColor="White" FontFamily="OpenSansSemibold" FontSize="15" HorizontalTextAlignment="Center" />
                <ProgressBar Progress="{Binding LoadingProgress}" IsVisible="{Binding HasLoadingProgress}" WidthRequest="220" />
                <Label Text="{Binding LoadingDetail}" Style="{StaticResource Muted}" FontSize="12" HorizontalTextAlignment="Center"
                       IsVisible="{Binding LoadingDetail, Converter={StaticResource HasValue}}" />
            </VerticalStackLayout>
        </Border>

        <!-- Too slow to stream smoothly: suggest letting the server download it all first. -->
        <Border IsVisible="{Binding IsTooSlow}" HorizontalOptions="Center" VerticalOptions="End" Margin="16,0,16,40" Padding="18,14" MaximumWidthRequest="460"
                BackgroundColor="#E60B0B12" StrokeShape="RoundRectangle 14">
            <VerticalStackLayout Spacing="10">
                <Label Text="This connection is too slow to stream it smoothly" TextColor="White" FontFamily="OpenSansSemibold" HorizontalTextAlignment="Center" />
                <Label Text="{Binding TooSlowText}" Style="{StaticResource Muted}" FontSize="12" HorizontalTextAlignment="Center" />
                <Button Text="Save on server and watch later" Command="{Binding SaveOnServerInsteadCommand}" HorizontalOptions="Center"
                        ImageSource="{controls:Icon cloud_download, Color=White, Size=20}" ContentLayout="Left,8" />
            </VerticalStackLayout>
        </Border>

        <!-- "−10s" / "+30s" after a double-tap or arrow key -->
        <Border x:Name="SkipFlash" IsVisible="False" Opacity="0" VerticalOptions="Center" Padding="18,10" Margin="60,0"
                BackgroundColor="#990B0B12" StrokeShape="RoundRectangle 24" InputTransparent="True">
            <VerticalStackLayout Spacing="8">
                <!-- TV skips: the frame they'll land on -->
                <Border x:Name="SkipPreview" IsVisible="False" StrokeShape="RoundRectangle 10" StrokeThickness="0" WidthRequest="240" HeightRequest="135">
                    <Image x:Name="SkipPreviewImage" Aspect="AspectFill" />
                </Border>
                <Label x:Name="SkipFlashText" TextColor="White" FontFamily="OpenSansSemibold" FontSize="18" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>

        <!-- Controls overlay -->
        <Grid x:Name="Controls" RowDefinitions="Auto,*,Auto" BackgroundColor="#66000000" Padding="12" controls:RemoteFocus.Skip="True">
            <!-- Its own single tap too: on Android a view with any tap recognizer keeps the touch, so a tap on the
                 controls never reached the surface's (and couldn't hide them). -->
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSurfaceTapped" />
            </Grid.GestureRecognizers>
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                <ImageButton Style="{StaticResource IconButton}" Source="{controls:Icon close, Color=White}" Clicked="OnClose"
                             SemanticProperties.Description="Close player" ToolTipProperties.Text="Close" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="16" LineBreakMode="TailTruncation" />
                    <Label x:Name="EndsAtLabel" Style="{StaticResource Muted}" FontSize="12" />
                </VerticalStackLayout>
                <ImageButton x:Name="CastButton" Grid.Column="2" Style="{StaticResource IconButton}" Source="{controls:Icon cast, Color=White}" Clicked="OnCast"
                             SemanticProperties.Description="Play on a TV" ToolTipProperties.Text="Cast" />
                <ImageButton x:Name="SubtitlesButton" Grid.Column="3" Style="{StaticResource IconButton}" Source="{controls:Icon closed_caption, Color=White, Outlined=True}" Clicked="OnSubtitles"
                             SemanticProperties.Description="Subtitles" ToolTipProperties.Text="Subtitles" />
                <ImageButton x:Name="QualityButton" Grid.Column="4" Style="{StaticResource IconButton}" Source="{controls:Icon high_quality, Color=White, Outlined=True}" Clicked="OnQuality"
                             SemanticProperties.Description="Quality" ToolTipProperties.Text="Quality" />
                <Button Grid.Column="5" x:Name="SpeedButton" Text="1x" Style="{StaticResource GhostButton}" TextColor="White" Clicked="OnSpeed" SemanticProperties.Description="Playback speed" />
                <ImageButton x:Name="AspectButton" Grid.Column="6" Style="{StaticResource IconButton}" Source="{controls:Icon fit_screen, Color=White, Outlined=True}" Clicked="OnAspect"
                             SemanticProperties.Description="Fill or fit the screen" ToolTipProperties.Text="Fill / fit" />
                <ImageButton x:Name="FullscreenButton" Grid.Column="7" Style="{StaticResource IconButton}" Source="{controls:Icon fullscreen, Color=White}" Clicked="OnFullscreen"
                             SemanticProperties.Description="Full screen" ToolTipProperties.Text="Full screen (F)" />
            </Grid>

            <HorizontalStackLayout x:Name="TransportControls" Grid.Row="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="36">
                <ImageButton x:Name="BackButton" Style="{StaticResource IconButton}" WidthRequest="60" HeightRequest="60" CornerRadius="30" Padding="12"
                             VerticalOptions="Center" Clicked="OnSkipBack" />
                <ImageButton x:Name="PlayPause" Source="{controls:Icon pause, Color=White, Size=40}" BackgroundColor="{StaticResource Primary}"
                             WidthRequest="72" HeightRequest="72" CornerRadius="36" Padding="16" Clicked="OnPlayPause"
                             SemanticProperties.Description="Play or pause" />
                <ImageButton x:Name="ForwardButton" Style="{StaticResource IconButton}" WidthRequest="60" HeightRequest="60" CornerRadius="30" Padding="12"
                             VerticalOptions="Center" Clicked="OnSkipForward" />
            </HorizontalStackLayout>

            <VerticalStackLayout x:Name="SeekArea" Grid.Row="2" Spacing="2">
                <!-- Near the end of a queue item: the next one, counting down, as Netflix does -->
                <Border x:Name="UpNextCard" IsVisible="False" HorizontalOptions="End" Padding="14,10" Margin="0,0,0,8"
                        BackgroundColor="#E60B0B12" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding UpNextTitle, StringFormat='Up next: {0}'}" TextColor="White" FontFamily="OpenSansSemibold" />
                        <Label x:Name="UpNextCountdown" Style="{StaticResource Muted}" FontSize="12" />
                        <HorizontalStackLayout Spacing="8">
                            <Button Text="Play now" Clicked="OnPlayNextNow" Padding="14,6" MinimumHeightRequest="36" />
                            <Button Text="Cancel" Style="{StaticResource SecondaryButton}" Clicked="OnCancelUpNext" Padding="14,6" MinimumHeightRequest="36" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <!-- While dragging: the frame and time the drag would jump to, above the thumb. -->
                <Border x:Name="SeekPreview" IsVisible="False" HorizontalOptions="Start" WidthRequest="176" Padding="0"
                        BackgroundColor="#E60B0B12" StrokeShape="RoundRectangle 8" InputTransparent="True">
                    <VerticalStackLayout>
                        <Image x:Name="SeekPreviewImage" HeightRequest="99" Aspect="AspectFill" />
                        <Label x:Name="SeekPreviewTime" TextColor="White" FontFamily="OpenSansSemibold" FontSize="13" HorizontalOptions="Center" Margin="0,4" />
                    </VerticalStackLayout>
                </Border>
                <!-- The slider's own track is see-through past the thumb: under it, the whole length, and lighter, how far the
                     video is there to play (buffered). Inset to line up with where each platform draws its track. -->
                <Grid>
                    <Grid x:Name="SeekTrack" HeightRequest="4" VerticalOptions="Center" InputTransparent="True"
                          Margin="{OnPlatform Android='16,0', Default='2,0'}">
                        <BoxView Color="#33FFFFFF" CornerRadius="2" />
                        <BoxView x:Name="BufferedTrack" Color="#80FFFFFF" CornerRadius="2" HorizontalOptions="Start" WidthRequest="0" />
                    </Grid>
                    <Slider x:Name="Seek" Minimum="0" Maximum="1" MaximumTrackColor="Transparent"
                            DragStarted="OnSeekStarted" DragCompleted="OnSeekCompleted" ValueChanged="OnSeekValueChanged" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                    <Label x:Name="PositionLabel" Text="0:00" FontSize="12" VerticalOptions="Center" />
                    <ImageButton x:Name="MuteButton" Grid.Column="2" Style="{StaticResource IconButton}" WidthRequest="36" HeightRequest="36" Padding="6"
                                 Clicked="OnMute" SemanticProperties.Description="Mute" ToolTipProperties.Text="Mute (M)" />
                    <Slider x:Name="VolumeSlider" Grid.Column="3" Minimum="0" Maximum="1" WidthRequest="{OnIdiom Default=110, Phone=84}" VerticalOptions="Center" ValueChanged="OnVolumeChanged"
                            SemanticProperties.Description="Volume" />
                    <!-- The screen's brightness, where the device lets the app set it (see DeviceControls) -->
                    <Image x:Name="BrightnessIcon" Grid.Column="4" Source="{controls:Icon brightness_6, Color=White}" WidthRequest="22" HeightRequest="22"
                           VerticalOptions="Center" Margin="6,0,0,0" />
                    <Slider x:Name="BrightnessSlider" Grid.Column="5" Minimum="0" Maximum="1" WidthRequest="{OnIdiom Default=110, Phone=84}" VerticalOptions="Center"
                            ValueChanged="OnBrightnessChanged" SemanticProperties.Description="Brightness" />
                    <Label Grid.Column="1" x:Name="DurationLabel" Text="0:00" FontSize="12" HorizontalOptions="End" VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
