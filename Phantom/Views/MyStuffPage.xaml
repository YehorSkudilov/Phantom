<?xml version="1.0" encoding="utf-8" ?>
<!-- The profile's own things: its watchlist, what it watched lately, and its playlists, as tabs. -->
<views:TabView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Phantom.Controls"
             xmlns:views="clr-namespace:Phantom.Views"
             xmlns:parts="clr-namespace:Phantom.Views.Parts"
             xmlns:vm="clr-namespace:Phantom.ViewModels"
             x:Class="Phantom.Views.MyStuffPage"
             x:DataType="vm:MyStuffViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <Label Text="My Library" Style="{StaticResource H1}" Padding="16,18,16,0" MinimumHeightRequest="62" VerticalTextAlignment="Center" />

        <controls:TabStrip Grid.Row="1" Tabs="{Binding Tabs}" SelectedIndex="{Binding SelectedTab}" Margin="0,4,0,0" />

        <!-- Search, kind, sort and grid or list, for Recently watched and Watchlist (not Playlists) -->
        <controls:ListToolbar Grid.Row="2" BindingContext="{Binding Filter}"
                              IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:MyStuffViewModel}}, Path=ShowsToolbar, x:DataType=vm:MyStuffViewModel}" />

        <parts:MovieGridView Grid.Row="3" BindingContext="{Binding Watchlist}"
                             IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:MyStuffViewModel}}, Path=SelectedTab, Converter={StaticResource Equals}, ConverterParameter=1, x:DataType=vm:MyStuffViewModel}" />
        <parts:MovieGridView Grid.Row="3" BindingContext="{Binding History}"
                             IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:MyStuffViewModel}}, Path=SelectedTab, Converter={StaticResource Equals}, ConverterParameter=0, x:DataType=vm:MyStuffViewModel}" />
        <parts:PlaylistsView Grid.Row="3" BindingContext="{Binding Playlists}"
                             IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:MyStuffViewModel}}, Path=SelectedTab, Converter={StaticResource Equals}, ConverterParameter=2, x:DataType=vm:MyStuffViewModel}" />
    </Grid>
</views:TabView>
