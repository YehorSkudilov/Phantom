<?xml version="1.0" encoding="utf-8" ?>
<!-- A grid of posters for a MovieListViewModel: the watchlist, recently watched or one collection. Used by the My Library
     tab's sub-tabs and by MovieListPage. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Phantom.ViewModels"
             xmlns:views="clr-namespace:Phantom.Views"
             xmlns:controls="clr-namespace:Phantom.Controls"
             x:Class="Phantom.Views.Parts.MovieGridView"
             x:DataType="vm:MovieListViewModel">
    <Grid RowDefinitions="Auto,*">
        <Label Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="16,8" IsVisible="{Binding Subtitle, Converter={StaticResource HasValue}}" />
        <!-- A grid of posters, or (My Library's toolbar) a list of rows -->
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}"
                     IsVisible="{Binding Filter.IsGrid, Converter={StaticResource Not}, FallbackValue=False}">
            <CollectionView ItemsSource="{Binding Shown}" ItemTemplate="{StaticResource MovieRow}" SelectionMode="Single" SelectionChanged="OnSelected">
                <CollectionView.Footer>
                    <BoxView HeightRequest="{x:Static views:TabView.NavBarInset}" Color="Transparent" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}"
                     IsVisible="{Binding Filter.IsGrid, FallbackValue=True}">
            <CollectionView ItemsSource="{Binding Shown}" ItemTemplate="{StaticResource PosterGridCard}" SelectionMode="Single"
                            SelectionChanged="OnSelected" Margin="12,0">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout x:Name="GridLayout" Orientation="Vertical" Span="3" HorizontalItemSpacing="10" VerticalItemSpacing="6" />
                </CollectionView.ItemsLayout>
                <CollectionView.Footer>
                    <BoxView HeightRequest="{x:Static views:TabView.NavBarInset}" Color="Transparent" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>
        <controls:StateView Grid.Row="1" Skeleton="Grid" HasContent="{Binding Movies.Count, Converter={StaticResource HasValue}}"
                            IsLoading="{Binding IsBusy}" HasLoaded="{Binding HasLoaded}" IsOffline="{Binding IsOffline}"
                            RetryCommand="{Binding LoadCommand}"
                            Glyph="{Binding EmptyGlyph}" Title="{Binding EmptyTitle}" Message="{Binding EmptyText}" />
    </Grid>
</ContentView>
