<?xml version="1.0" encoding="utf-8" ?>
<!-- Movies the server is downloading or keeps, under Downloads → On the server. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Phantom.Controls"
             xmlns:views="clr-namespace:Phantom.Views"
             xmlns:vm="clr-namespace:Phantom.ViewModels"
             xmlns:dto="clr-namespace:Phantom.Shared;assembly=Phantom.Shared"
             x:Class="Phantom.Views.Parts.ServerDownloadsView"
             x:DataType="vm:ServerDownloadsViewModel">
    <Grid RowDefinitions="Auto,Auto,*">
        <Label Text="Movies saved on the server's own disk: they start instantly, and are deleted automatically after the time set in Manage server."
               Style="{StaticResource Muted}" Margin="16,8,16,0" />
        <Label Grid.Row="1" Text="{Binding Totals}" Margin="16,8" FontSize="13" TextColor="{StaticResource Accent}" />
        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
        <CollectionView ItemsSource="{Binding Items}" SelectionMode="None">
            <CollectionView.Footer>
                <BoxView HeightRequest="{x:Static views:TabView.NavBarInset}" Color="Transparent" />
            </CollectionView.Footer>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:ServerDownloadDto">
                    <Border Style="{StaticResource Card}" Margin="16,6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ServerDownloadsViewModel}}, Path=OpenCommand, x:DataType=vm:ServerDownloadsViewModel}"
                                                          CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4">
                            <Label Text="{Binding MovieTitle}" FontFamily="OpenSansSemibold" FontSize="15" LineBreakMode="TailTruncation" />
                            <Label Grid.Row="1" Text="{Binding ReleaseName}" Style="{StaticResource Muted}" FontSize="11" LineBreakMode="MiddleTruncation" />
                            <ProgressBar Grid.Row="2" Progress="{Binding Progress, Converter={StaticResource Percent}}" Margin="0,4" />
                            <Label Grid.Row="3" Style="{StaticResource Muted}" FontSize="12">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Status}" />
                                        <Span Text="  ·  " />
                                        <Span Text="{Binding Progress, StringFormat='{0:0.#}%'}" />
                                        <Span Text="  ·  " />
                                        <Span Text="{Binding SizeBytes, Converter={StaticResource Bytes}}" />
                                        <Span Text="  ·  ↓ " />
                                        <Span Text="{Binding DownloadRate, Converter={StaticResource Bytes}, ConverterParameter=rate}" />
                                        <Span Text="  ·  " />
                                        <Span Text="{Binding Peers, StringFormat='{0} peers'}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <HorizontalStackLayout Grid.Column="1" Grid.RowSpan="2">
                                <ImageButton Style="{StaticResource IconButton}" Source="{controls:Icon pause_circle, Outlined=True}" SemanticProperties.Description="Pause or resume" ToolTipProperties.Text="Pause or resume"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ServerDownloadsViewModel}}, Path=ToggleCommand, x:DataType=vm:ServerDownloadsViewModel}"
                                        CommandParameter="{Binding .}" />
                                <ImageButton Style="{StaticResource IconButton}" Source="{controls:Icon delete, Outlined=True}" SemanticProperties.Description="Delete" ToolTipProperties.Text="Delete"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ServerDownloadsViewModel}}, Path=RemoveCommand, x:DataType=vm:ServerDownloadsViewModel}"
                                        CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                            <Label Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding ExpiresAt, StringFormat='Kept on the server until {0:d MMM}'}" FontSize="12"
                                   TextColor="{StaticResource PrimaryLight}" IsVisible="{Binding ExpiresAt, Converter={StaticResource HasValue}}" />
                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding Error}" TextColor="{StaticResource Danger}" FontSize="11"
                                   IsVisible="{Binding Error, Converter={StaticResource HasValue}}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </RefreshView>
        <controls:StateView Grid.Row="2" Skeleton="List" HasContent="{Binding Items.Count, Converter={StaticResource HasValue}}"
                            HasLoaded="{Binding HasLoaded}" IsOffline="{Binding IsOffline}" RetryCommand="{Binding RefreshCommand}"
                            Glyph="cloud_download" Title="Nothing on the server yet"
                            Message="Tap Save on server on a movie or an episode: the server downloads it once and keeps it, for everyone here to watch." />
    </Grid>
</ContentView>
