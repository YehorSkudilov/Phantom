<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Phantom.Controls"
             xmlns:vm="clr-namespace:Phantom.ViewModels"
             xmlns:dto="clr-namespace:Phantom.Shared;assembly=Phantom.Shared"
             x:Class="Phantom.Views.ProfilesPage"
             x:DataType="vm:ProfilesViewModel">
    <ContentPage.Resources>
        <!-- The see-through button over a profile's tile: none of the usual button looks (a grey wash while it's
             disabled, a colour under the mouse), only focus, which the tile itself shows -->
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="Transparent" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList />
            </Setter>
        </Style>
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,*,Auto" Padding="24,64,24,24" RowSpacing="24">
        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
            <Image Source="logo_mark.png" HeightRequest="56" />
            <Label Text="Who's watching?" Style="{StaticResource H1}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- A wrapping row rather than a CollectionView: a centred CollectionView grid sizes itself from its items and
             its items from it, which WinUI reports as a layout cycle and crashes on. -->
        <ScrollView Grid.Row="1">
            <FlexLayout x:Name="Tiles" BindableLayout.ItemsSource="{Binding Profiles}" Wrap="Wrap" JustifyContent="Center" AlignContent="Start">
                <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="dto:UserDto">
                    <!-- The tile, with a see-through button over all of it: a button is what a TV remote can move to and
                         press with OK (a tap on a layout isn't, reliably). Moving to it grows the tile and rings the
                         avatar (see ProfilesPage.OnTileFocused). -->
                    <Grid WidthRequest="104" Margin="6" Padding="4">
                        <VerticalStackLayout Spacing="8" InputTransparent="True">
                            <Border WidthRequest="88" HeightRequest="88" StrokeShape="RoundRectangle 22" BackgroundColor="{Binding AvatarColor}"
                                    Stroke="Transparent" StrokeThickness="0">
                                <Label Text="{Binding Username, Converter={StaticResource Initial}}" FontSize="34" FontFamily="OpenSansSemibold"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="{Binding Username}" HorizontalOptions="Center" LineBreakMode="TailTruncation" />
                            <Label Text="Default" Style="{StaticResource Muted}" FontSize="11" HorizontalOptions="Center"
                                   IsVisible="{Binding IsManaged, Converter={StaticResource Not}}" />
                            <Image Source="{controls:Icon lock, Color={StaticResource TextSecondary}}" IsVisible="{Binding HasPin}" HorizontalOptions="Center" WidthRequest="14" HeightRequest="14" />
                        </VerticalStackLayout>
                        <Button Style="{StaticResource TileButton}" Text=""
                                Focused="OnTileFocused" Unfocused="OnTileUnfocused"
                                SemanticProperties.Description="{Binding Username, StringFormat='Watch as {0}'}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProfilesViewModel}}, Path=SelectCommand, x:DataType=vm:ProfilesViewModel}"
                                CommandParameter="{Binding .}">
                            <FlyoutBase.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Delete profile"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProfilesViewModel}}, Path=DeleteProfileCommand, x:DataType=vm:ProfilesViewModel}"
                                                    CommandParameter="{Binding .}" />
                                </MenuFlyout>
                            </FlyoutBase.ContextFlyout>
                        </Button>
                    </Grid>
                </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="2" Spacing="10">
            <Button Text="+ Add profile" Style="{StaticResource SecondaryButton}" Command="{Binding AddProfileCommand}"
                    IsVisible="{Binding CanManage}" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
