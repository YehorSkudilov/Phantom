<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Phantom.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Phantom.Views"
    Title="Phantom"
    FlyoutBehavior="Disabled">

    <ShellContent x:Name="ConnectItem" Route="connect" ContentTemplate="{DataTemplate views:ConnectPage}" Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False" />
    <ShellContent Route="profiles" ContentTemplate="{DataTemplate views:ProfilesPage}" Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False" />

    <!-- The tabs are a CNavBar + CView inside MainPage; Shell only handles sign-in and pushing detail pages on top. -->
    <ShellContent x:Name="MainItem" Route="main" ContentTemplate="{DataTemplate views:MainPage}" Shell.NavBarIsVisible="False" />
</Shell>
