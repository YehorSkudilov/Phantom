<?xml version="1.0" encoding="utf-8" ?>
<views:TabView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Phantom.Controls"
             xmlns:views="clr-namespace:Phantom.Views"
             xmlns:parts="clr-namespace:Phantom.Views.Parts"
             xmlns:vm="clr-namespace:Phantom.ViewModels"
             x:Class="Phantom.Views.LibraryPage"
             x:DataType="vm:LibraryViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto,Auto" Padding="16,18,8,0" MinimumHeightRequest="62">
            <Label Text="Library" Style="{StaticResource H1}" VerticalOptions="Center" />
            <!-- Filters (and sort) live in one popup; a dot shows while any filter narrows the library -->
            <Grid Grid.Column="1" IsVisible="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=0}">
                <ImageButton Style="{StaticResource IconButton}" Source="{controls:Icon tune}" Command="{Binding ToggleFiltersCommand}"
                             SemanticProperties.Description="Filters and sort" ToolTipProperties.Text="Filters and sort" />
                <Border WidthRequest="9" HeightRequest="9" StrokeShape="RoundRectangle 4.5" BackgroundColor="{StaticResource Primary}"
                        HorizontalOptions="End" VerticalOptions="Start" Margin="0,9,9,0" InputTransparent="True"
                        IsVisible="{Binding HasActiveFilters}" />
            </Grid>
            <Grid Grid.Column="2" IsVisible="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=0}">
                <ImageButton Style="{StaticResource IconButton}" Source="{controls:Icon view_list}" Command="{Binding ToggleViewCommand}" IsVisible="{Binding IsGrid}"
                             SemanticProperties.Description="Show as list" ToolTipProperties.Text="Show as list" />
                <ImageButton Style="{StaticResource IconButton}" Source="{controls:Icon grid_view}" Command="{Binding ToggleViewCommand}" IsVisible="{Binding IsGrid, Converter={StaticResource Not}}"
                             SemanticProperties.Description="Show as grid" ToolTipProperties.Text="Show as grid" />
            </Grid>
        </Grid>

        <controls:TabStrip Grid.Row="1" Tabs="{Binding Tabs}" SelectedIndex="{Binding SelectedTab}" Margin="0,4,0,0" />

        <!-- Search: typing swaps the library below for results across titles, cast and genres. -->
        <SearchBar Grid.Row="2" x:Name="Box" IsVisible="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=0}" Text="{Binding Search.Query}" Placeholder="Search movies, shows, actors, genres"
                   SearchCommand="{Binding Search.SearchCommand}" Margin="8,6,8,0" />

        <Grid Grid.Row="3" RowDefinitions="Auto,*">
            <Grid.IsVisible>
                <MultiBinding Converter="{StaticResource AllTrue}">
                    <Binding Path="SelectedTab" Converter="{StaticResource Equals}" ConverterParameter="0" />
                    <Binding Path="Search.Query" Converter="{StaticResource HasValue}" ConverterParameter="invert" />
                </MultiBinding>
            </Grid.IsVisible>
        <!-- One compact row above the list: All / Movies / TV shows, and how many there are. Sort and filters are in the
             popup behind the Filters button. -->
        <Grid ColumnDefinitions="Auto,*" Padding="16,6,16,6" ColumnSpacing="10">
            <HorizontalStackLayout Spacing="6">
                <Button Text="All" Command="{Binding ShowAllCommand}" Style="{StaticResource SecondaryButton}" Padding="12,0" HeightRequest="32" MinimumHeightRequest="32" FontSize="13">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsAll}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            <Setter Property="TextColor" Value="{StaticResource White}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Text="Movies" Command="{Binding ShowMoviesCommand}" Style="{StaticResource SecondaryButton}" Padding="12,0" HeightRequest="32" MinimumHeightRequest="32" FontSize="13">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsMovies}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            <Setter Property="TextColor" Value="{StaticResource White}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Text="TV shows" Command="{Binding ShowTvCommand}" Style="{StaticResource SecondaryButton}" Padding="12,0" HeightRequest="32" MinimumHeightRequest="32" FontSize="13">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsShows}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            <Setter Property="TextColor" Value="{StaticResource White}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </HorizontalStackLayout>
            <Label Grid.Column="1" Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="12" VerticalOptions="Center"
                   HorizontalOptions="End" HorizontalTextAlignment="End" LineBreakMode="TailTruncation" />
        </Grid>

        <!-- One RefreshView per view: on iOS a RefreshView only hooks onto the first list inside it, which left the list
             view (the second) without pull-to-refresh. -->
        <Grid Grid.Row="1">
            <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding ReloadCommand}" IsVisible="{Binding IsGrid}">
                <CollectionView x:Name="Grid" ItemsSource="{Binding Movies}" Scrolled="OnListScrolled"
                                ItemTemplate="{StaticResource PosterCard}" SelectionMode="Single"
                                SelectionChanged="OnSelected"
                                RemainingItemsThreshold="45" RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout x:Name="GridLayout" Orientation="Vertical" Span="3" HorizontalItemSpacing="10" VerticalItemSpacing="6" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.Footer>
                        <VerticalStackLayout Padding="0,8,0,0">
                            <ActivityIndicator IsRunning="{Binding IsLoadingMore}" IsVisible="{Binding IsLoadingMore}" HorizontalOptions="Center" />
                            <BoxView HeightRequest="{x:Static views:TabView.NavBarInset}" Color="Transparent" />
                        </VerticalStackLayout>
                    </CollectionView.Footer>
                    <CollectionView.EmptyView>
                        <Label Text="Nothing matches these filters." Style="{StaticResource Muted}" HorizontalOptions="Center" Margin="0,40" />
                    </CollectionView.EmptyView>
                </CollectionView>
            </RefreshView>
            <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding ReloadCommand}" IsVisible="{Binding IsGrid, Converter={StaticResource Not}}">
                <CollectionView ItemsSource="{Binding Movies}" Scrolled="OnListScrolled"
                                ItemTemplate="{StaticResource MovieRow}" SelectionMode="Single" SelectionChanged="OnSelected"
                                RemainingItemsThreshold="45" RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                    <CollectionView.Footer>
                        <VerticalStackLayout Padding="0,8,0,0">
                            <ActivityIndicator IsRunning="{Binding IsLoadingMore}" IsVisible="{Binding IsLoadingMore}" HorizontalOptions="Center" />
                            <BoxView HeightRequest="{x:Static views:TabView.NavBarInset}" Color="Transparent" />
                        </VerticalStackLayout>
                    </CollectionView.Footer>
                    <CollectionView.EmptyView>
                        <Label Text="Nothing matches these filters." Style="{StaticResource Muted}" HorizontalOptions="Center" Margin="0,40" />
                    </CollectionView.EmptyView>
                </CollectionView>
            </RefreshView>
        </Grid>
        </Grid>

        <!-- Search results -->
        <ScrollView Grid.Row="3" x:DataType="vm:LibraryViewModel">
            <ScrollView.IsVisible>
                <MultiBinding Converter="{StaticResource AllTrue}">
                    <Binding Path="SelectedTab" Converter="{StaticResource Equals}" ConverterParameter="0" />
                    <Binding Path="Search.Query" Converter="{StaticResource HasValue}" />
                </MultiBinding>
            </ScrollView.IsVisible>
            <VerticalStackLayout BindingContext="{Binding Search}" x:DataType="vm:SearchViewModel">
            <VerticalStackLayout Spacing="10" Padding="0,8,0,108">
                <Label Text="No results." Style="{StaticResource Muted}" HorizontalOptions="Center" Margin="0,40" IsVisible="{Binding NoResults}" />

                <Label Text="People" Style="{StaticResource H2}" Margin="16,8,16,0" IsVisible="{Binding People.Count, Converter={StaticResource HasValue}}" />
                <FlexLayout BindableLayout.ItemsSource="{Binding People}" Wrap="Wrap" Margin="12,0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button Text="{Binding .}" Style="{StaticResource SecondaryButton}" Margin="4"
                                    ImageSource="{controls:Icon person, Size=18}" ContentLayout="Left,6"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, Path=OpenPersonCommand, x:DataType=vm:SearchViewModel}"
                                    CommandParameter="{Binding .}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <Label Text="Genres" Style="{StaticResource H2}" Margin="16,8,16,0" IsVisible="{Binding Genres.Count, Converter={StaticResource HasValue}}" />
                <FlexLayout BindableLayout.ItemsSource="{Binding Genres}" Wrap="Wrap" Margin="12,0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button Text="{Binding .}" Style="{StaticResource SecondaryButton}" Margin="4"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, Path=OpenGenreCommand, x:DataType=vm:SearchViewModel}"
                                    CommandParameter="{Binding .}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <Label Text="Movies" Style="{StaticResource H2}" Margin="16,8,16,0" IsVisible="{Binding Movies.Count, Converter={StaticResource HasValue}}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Movies}" BindableLayout.ItemTemplate="{StaticResource MovieRow}" x:Name="SearchMovies" />
            </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- The profile's own lists -->
        <parts:MovieGridView Grid.Row="3" BindingContext="{Binding Watchlist}"
                             IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryViewModel}}, Path=SelectedTab, Converter={StaticResource Equals}, ConverterParameter=1, x:DataType=vm:LibraryViewModel}" />
        <parts:MovieGridView Grid.Row="3" BindingContext="{Binding History}"
                             IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryViewModel}}, Path=SelectedTab, Converter={StaticResource Equals}, ConverterParameter=2, x:DataType=vm:LibraryViewModel}" />
        <parts:CollectionsView Grid.Row="3" BindingContext="{Binding Collections}"
                               IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryViewModel}}, Path=SelectedTab, Converter={StaticResource Equals}, ConverterParameter=3, x:DataType=vm:LibraryViewModel}" />
        <parts:PlaylistsView Grid.Row="3" BindingContext="{Binding Playlists}"
                             IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryViewModel}}, Path=SelectedTab, Converter={StaticResource Equals}, ConverterParameter=4, x:DataType=vm:LibraryViewModel}" />

        <!-- Filters and sort popup: a dimmed backdrop (tap to close) and a card, kept clear of the floating nav bar (84 =
             TabView.NavBarInset). Changes apply as they're made. -->
        <Grid Grid.RowSpan="4" IsVisible="{Binding ShowFilters}">
            <BoxView Color="{StaticResource Scrim}">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseFiltersCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border Style="{StaticResource Card}" Padding="18" Margin="16,16,16,84"
                    VerticalOptions="Center" MaximumWidthRequest="480" BackgroundColor="{StaticResource SurfaceRaised}">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.45" Radius="24" Offset="0,8" />
                </Border.Shadow>
                <ScrollView>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Filters" Style="{StaticResource H2}" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="{Binding ClearFiltersText}" Style="{StaticResource GhostButton}"
                                    Command="{Binding ClearFiltersCommand}" IsEnabled="{Binding HasActiveFilters}" />
                        </Grid>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="Sort by" Style="{StaticResource Muted}" FontSize="12" />
                            <Picker ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" SemanticProperties.Description="Sort by" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Genre" Style="{StaticResource Muted}" FontSize="12" />
                                <Picker ItemsSource="{Binding Genres}" SelectedItem="{Binding SelectedGenre}" SemanticProperties.Description="Genre" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Decade" Style="{StaticResource Muted}" FontSize="12" />
                                <Picker ItemsSource="{Binding Decades}" SelectedItem="{Binding SelectedDecade}" SemanticProperties.Description="Decade" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Spacing="2">
                                <Label Text="Watched" Style="{StaticResource Muted}" FontSize="12" />
                                <Picker ItemsSource="{Binding WatchStates}" SelectedItem="{Binding SelectedWatchState}" SemanticProperties.Description="Watched" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                                <Label Text="Content rating" Style="{StaticResource Muted}" FontSize="12" />
                                <Picker ItemsSource="{Binding Ratings}" SelectedItem="{Binding SelectedRating}" SemanticProperties.Description="Content rating" />
                            </VerticalStackLayout>
                            <!-- Shows have no quality: the A–Z choice takes the row alone then -->
                            <VerticalStackLayout Grid.Row="2" Spacing="2" IsVisible="{Binding IsShows, Converter={StaticResource Not}}">
                                <Label Text="Quality" Style="{StaticResource Muted}" FontSize="12" />
                                <Picker ItemsSource="{Binding Qualities}" SelectedItem="{Binding SelectedQuality}" SemanticProperties.Description="Quality" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="2">
                                <Label Text="Starts with" Style="{StaticResource Muted}" FontSize="12" />
                                <Picker ItemsSource="{Binding Letters}" SelectedItem="{Binding SelectedLetter}" SemanticProperties.Description="Title starts with" />
                            </VerticalStackLayout>
                        </Grid>

                        <Button Text="Done" Command="{Binding CloseFiltersCommand}" Margin="0,4,0,0" />
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</views:TabView>
