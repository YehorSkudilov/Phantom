<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Phantom.ViewModels"
             xmlns:controls="clr-namespace:Phantom.Controls"
             xmlns:dto="clr-namespace:Phantom.Shared;assembly=Phantom.Shared"
             x:Class="Phantom.Views.AdminPage"
             x:DataType="vm:AdminViewModel"
             Title="Manage server">
    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" IsVisible="{Binding ErrorMessage, Converter={StaticResource HasValue}}" />

                <!-- Status -->
                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" RowSpacing="2">
                        <Label Text="{Binding Info.MovieCount}" Style="{StaticResource H1}" HorizontalOptions="Center" />
                        <Label Grid.Row="1" Text="Movies" Style="{StaticResource Muted}" HorizontalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding Info.ActiveTorrents}" Style="{StaticResource H1}" HorizontalOptions="Center" />
                        <Label Grid.Column="1" Grid.Row="1" Text="Active torrents" Style="{StaticResource Muted}" HorizontalOptions="Center" />
                        <Label Grid.Column="2" Text="{Binding Info.FreeDiskBytes, Converter={StaticResource Bytes}}" Style="{StaticResource H2}" HorizontalOptions="Center" VerticalOptions="Center" />
                        <Label Grid.Column="2" Grid.Row="1" Text="Free disk" Style="{StaticResource Muted}" HorizontalOptions="Center" />
                    </Grid>
                </Border>
                <Label Style="{StaticResource Muted}" FontSize="12">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Downloading " />
                            <Span Text="{Binding Info.DownloadRate, Converter={StaticResource Bytes}, ConverterParameter=rate}" />
                            <Span Text="   ·   Uploading " />
                            <Span Text="{Binding Info.UploadRate, Converter={StaticResource Bytes}, ConverterParameter=rate}" />
                            <Span Text="&#10;" />
                            <Span Text="{Binding FeaturesText}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!-- Now playing -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Now playing" Style="{StaticResource H2}" VerticalOptions="Center" />
                    <ImageButton Grid.Column="1" Style="{StaticResource IconButton}" Source="{controls:Icon refresh}" Command="{Binding RefreshActivityCommand}"
                                 SemanticProperties.Description="Refresh" ToolTipProperties.Text="Refresh" />
                </Grid>
                <Label Text="Nobody is watching right now." Style="{StaticResource Muted}" IsVisible="{Binding Sessions.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sessions}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dto:NowPlayingDto">
                            <Border Style="{StaticResource Card}" Padding="10">
                                <Grid ColumnDefinitions="44,*" ColumnSpacing="10">
                                    <Border StrokeShape="RoundRectangle 4" HeightRequest="64">
                                        <Image Source="{Binding PosterUrl, Converter={StaticResource Poster}}" Aspect="AspectFill" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding MovieTitle}" FontFamily="OpenSansSemibold" />
                                        <Label Style="{StaticResource Muted}" FontSize="12">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Username}" />
                                                    <Span Text=" on " />
                                                    <Span Text="{Binding ClientName}" />
                                                    <Span Text="  ·  " />
                                                    <Span Text="{Binding State}" />
                                                    <Span Text="  ·  " />
                                                    <Span Text="{Binding PositionMs, Converter={StaticResource Time}}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Sources -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Sources" Style="{StaticResource H2}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Check all now" Style="{StaticResource GhostButton}" Command="{Binding SyncAllCommand}"
                            ImageSource="{controls:Icon sync, Color={StaticResource PrimaryLight}, Size=20}" ContentLayout="Left,6" />
                </Grid>
                <Label Text="Phantom checks these for new movies on a schedule. Turn one off to pause it."
                       Style="{StaticResource Muted}" FontSize="12" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sources}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dto:SourceDto">
                            <Border Style="{StaticResource Card}">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="2">
                                    <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                                    <Label Grid.Row="1" Style="{StaticResource Muted}" FontSize="12">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Type, Converter={StaticResource SourceType}}" />
                                                <Span Text="  ·  checks " />
                                                <Span Text="{Binding SyncIntervalMinutes, Converter={StaticResource Interval}}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label Grid.Row="2" Text="{Binding LastSyncResult}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"
                                           IsVisible="{Binding LastSyncResult, Converter={StaticResource HasValue}}" />
                                    <ImageButton Grid.Column="1" Grid.RowSpan="3" Style="{StaticResource IconButton}" VerticalOptions="Center"
                                                 Source="{controls:Icon sync}" SemanticProperties.Description="Check now" ToolTipProperties.Text="Check now"
                                                 Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}, Path=SyncCommand, x:DataType=vm:AdminViewModel}" CommandParameter="{Binding .}" />
                                    <ImageButton Grid.Column="2" Grid.RowSpan="3" Style="{StaticResource IconButton}" VerticalOptions="Center"
                                                 Source="{controls:Icon delete, Outlined=True, Color={StaticResource Danger}}" SemanticProperties.Description="Remove" ToolTipProperties.Text="Remove"
                                                 Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}, Path=DeleteSourceCommand, x:DataType=vm:AdminViewModel}" CommandParameter="{Binding .}" />
                                    <Switch Grid.Column="3" Grid.RowSpan="3" VerticalOptions="Center" IsToggled="{Binding Enabled, Mode=OneWay}" Toggled="OnSourceToggled"
                                            SemanticProperties.Description="On or off" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Button Text="Add source" Style="{StaticResource SecondaryButton}" Command="{Binding AddSourceCommand}"
                        ImageSource="{controls:Icon add, Size=20}" ContentLayout="Left,6" />

                <!-- Accounts -->
                <Label Text="Accounts" Style="{StaticResource H2}" Margin="0,8,0,0" />
                <Label Text="Everyone signs in with their own account, and each account has its own profiles."
                       Style="{StaticResource Muted}" FontSize="12" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Accounts}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:UserDto">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" Padding="14,8">
                                    <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 10" BackgroundColor="{Binding AvatarColor}">
                                        <Label Text="{Binding Username, Converter={StaticResource Initial}}" FontFamily="OpenSansSemibold"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding Username}" FontFamily="OpenSansSemibold" />
                                        <Label Text="Admin" Style="{StaticResource Muted}" FontSize="12" IsVisible="{Binding IsAdmin}" />
                                    </VerticalStackLayout>
                                    <ImageButton Grid.Column="2" Style="{StaticResource IconButton}"
                                                 Source="{controls:Icon admin_panel_settings, Outlined=True}" SemanticProperties.Description="Admin on or off" ToolTipProperties.Text="Admin on or off"
                                                 Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}, Path=ToggleAdminCommand, x:DataType=vm:AdminViewModel}" CommandParameter="{Binding .}" />
                                    <ImageButton Grid.Column="3" Style="{StaticResource IconButton}"
                                                 Source="{controls:Icon delete, Outlined=True, Color={StaticResource Danger}}" SemanticProperties.Description="Delete account" ToolTipProperties.Text="Delete account"
                                                 Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}, Path=DeleteAccountCommand, x:DataType=vm:AdminViewModel}" CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
                <Button Text="Add account" Style="{StaticResource SecondaryButton}" Command="{Binding AddAccountCommand}"
                        ImageSource="{controls:Icon person_add, Size=20}" ContentLayout="Left,6" />

                <!-- Settings -->
                <Label Text="Server settings" Style="{StaticResource H2}" Margin="0,8,0,0" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Server name" Style="{StaticResource Muted}" />
                        <Entry Text="{Binding ServerName}" />
                        <Label Text="Preferred quality for new streams" Style="{StaticResource Muted}" />
                        <Picker ItemsSource="{Binding QualityChoices}" SelectedItem="{Binding PreferredQuality}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                            <Label Text="Max active downloads" Style="{StaticResource Muted}" />
                            <Label Grid.Column="1" Text="Min seeders to import" Style="{StaticResource Muted}" />
                            <Entry Grid.Row="1" Text="{Binding MaxActiveDownloads}" Keyboard="Numeric" />
                            <Entry Grid.Row="1" Grid.Column="1" Text="{Binding MinSeeders}" Keyboard="Numeric" />
                            <Label Grid.Row="2" Text="Download limit (KB/s, 0 = ∞)" Style="{StaticResource Muted}" />
                            <Label Grid.Row="2" Grid.Column="1" Text="Upload limit (KB/s, 0 = ∞)" Style="{StaticResource Muted}" />
                            <Entry Grid.Row="3" Text="{Binding MaxDownloadKbps}" Keyboard="Numeric" />
                            <Entry Grid.Row="3" Grid.Column="1" Text="{Binding MaxUploadKbps}" Keyboard="Numeric" />
                        </Grid>
                        <Label Text="Keep streamed torrents cached for (hours)" Style="{StaticResource Muted}" />
                        <Entry Text="{Binding StreamCacheHours}" Keyboard="Numeric" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Seed after downloading" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding SeedAfterDownload}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Auto-download newly found movies" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding AutoDownloadNewReleases}" />
                        </Grid>
                        <Button Text="Save settings" Command="{Binding SaveSettingsCommand}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
