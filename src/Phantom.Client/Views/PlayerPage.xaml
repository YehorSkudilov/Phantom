<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Phantom.ViewModels"
             xmlns:controls="clr-namespace:Phantom.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Phantom.Views.PlayerPage"
             x:DataType="vm:PlayerViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="Black">
    <Grid>
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnSurfaceTapped" />
        </Grid.GestureRecognizers>

        <toolkit:MediaElement x:Name="Media" ShouldShowPlaybackControls="False" ShouldAutoPlay="True" ShouldKeepScreenOn="True"
                              Aspect="AspectFit" MetadataTitle="{Binding Title}" MetadataArtworkUrl="{Binding PosterUrl}"
                              Speed="{Binding Speed}" />

        <!-- Subtitles are rendered by Phantom (MediaElement has no subtitle support). -->
        <Label Text="{Binding SubtitleText}" FontSize="{Binding SubtitleSize}" TextColor="White" BackgroundColor="#99000000"
               Padding="10,4" HorizontalOptions="Center" VerticalOptions="End" Margin="24,0,24,96"
               HorizontalTextAlignment="Center" IsVisible="{Binding SubtitleText, Converter={StaticResource HasValue}}" />

        <!-- Loading: what the server is doing to get the movie playing (see PlayerViewModel.PollStatusAsync). -->
        <Border x:Name="Buffering" HorizontalOptions="Center" VerticalOptions="Center" Padding="24,20" MaximumWidthRequest="420"
                BackgroundColor="#CC0B0B12" StrokeShape="RoundRectangle 16" InputTransparent="True">
            <VerticalStackLayout Spacing="10">
                <ActivityIndicator IsRunning="True" WidthRequest="44" HeightRequest="44" />
                <Label Text="{Binding LoadingText}" TextColor="White" FontFamily="OpenSansSemibold" FontSize="15" HorizontalTextAlignment="Center" />
                <ProgressBar Progress="{Binding LoadingProgress}" IsVisible="{Binding HasLoadingProgress}" WidthRequest="220" />
                <Label Text="{Binding LoadingDetail}" Style="{StaticResource Muted}" FontSize="12" HorizontalTextAlignment="Center"
                       IsVisible="{Binding LoadingDetail, Converter={StaticResource HasValue}}" />
            </VerticalStackLayout>
        </Border>
        <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,120,0,0"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource HasValue}}" />

        <!-- Controls overlay -->
        <Grid x:Name="Controls" RowDefinitions="Auto,*,Auto" BackgroundColor="#66000000" Padding="12">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
                <ImageButton Style="{StaticResource IconButton}" Source="{controls:Icon close, Color=White}" Clicked="OnClose"
                             SemanticProperties.Description="Close player" ToolTipProperties.Text="Close" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="16" LineBreakMode="TailTruncation" />
                    <Label Text="Transcoding" Style="{StaticResource Muted}" FontSize="11" IsVisible="{Binding IsTranscoding}" />
                </VerticalStackLayout>
                <ImageButton Grid.Column="2" Style="{StaticResource IconButton}" Source="{controls:Icon closed_caption, Color=White, Outlined=True}" Clicked="OnSubtitles"
                             SemanticProperties.Description="Subtitles" ToolTipProperties.Text="Subtitles" />
                <ImageButton Grid.Column="3" Style="{StaticResource IconButton}" Source="{controls:Icon high_quality, Color=White, Outlined=True}" Clicked="OnQuality"
                             SemanticProperties.Description="Quality" ToolTipProperties.Text="Quality" />
                <Button Grid.Column="4" x:Name="SpeedButton" Text="1x" Style="{StaticResource GhostButton}" TextColor="White" Clicked="OnSpeed" SemanticProperties.Description="Playback speed" />
            </Grid>

            <HorizontalStackLayout Grid.Row="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="36">
                <ImageButton x:Name="BackButton" Style="{StaticResource IconButton}" WidthRequest="60" HeightRequest="60" CornerRadius="30" Padding="12"
                             VerticalOptions="Center" Clicked="OnSkipBack" />
                <ImageButton x:Name="PlayPause" Source="{controls:Icon pause, Color=White, Size=40}" BackgroundColor="{StaticResource Primary}"
                             WidthRequest="72" HeightRequest="72" CornerRadius="36" Padding="16" Clicked="OnPlayPause"
                             SemanticProperties.Description="Play or pause" />
                <ImageButton x:Name="ForwardButton" Style="{StaticResource IconButton}" WidthRequest="60" HeightRequest="60" CornerRadius="30" Padding="12"
                             VerticalOptions="Center" Clicked="OnSkipForward" />
            </HorizontalStackLayout>

            <VerticalStackLayout Grid.Row="2" Spacing="2">
                <Label Text="{Binding UpNextTitle, StringFormat='Up next: {0}'}" Style="{StaticResource Muted}" HorizontalOptions="End"
                       IsVisible="{Binding UpNextTitle, Converter={StaticResource HasValue}}" />
                <!-- While dragging: the frame and time the drag would jump to, above the thumb. -->
                <Border x:Name="SeekPreview" IsVisible="False" HorizontalOptions="Start" WidthRequest="176" Padding="0"
                        BackgroundColor="#E60B0B12" StrokeShape="RoundRectangle 8" InputTransparent="True">
                    <VerticalStackLayout>
                        <Image x:Name="SeekPreviewImage" HeightRequest="99" Aspect="AspectFill" />
                        <Label x:Name="SeekPreviewTime" TextColor="White" FontFamily="OpenSansSemibold" FontSize="13" HorizontalOptions="Center" Margin="0,4" />
                    </VerticalStackLayout>
                </Border>
                <Slider x:Name="Seek" Minimum="0" Maximum="1" DragStarted="OnSeekStarted" DragCompleted="OnSeekCompleted" ValueChanged="OnSeekValueChanged" />
                <Grid ColumnDefinitions="*,*">
                    <Label x:Name="PositionLabel" Text="0:00" FontSize="12" />
                    <Label Grid.Column="1" x:Name="DurationLabel" Text="0:00" FontSize="12" HorizontalOptions="End" />
                </Grid>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
