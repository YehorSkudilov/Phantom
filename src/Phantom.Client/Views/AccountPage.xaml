<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Phantom.Controls"
             xmlns:vm="clr-namespace:Phantom.ViewModels"
             xmlns:skeleton="clr-namespace:AppSkeleton;assembly=AppSkeleton"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Phantom.Views.AccountPage"
             x:DataType="vm:AccountViewModel"
             Title="Username and password">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14" MaximumWidthRequest="640">
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" IsVisible="{Binding ErrorMessage, Converter={StaticResource HasValue}}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Sign-in details" Style="{StaticResource H2}" />
                    <Label Text="Your username is what you sign in with, and the name of your default profile." Style="{StaticResource Muted}" />
                    <Label Text="Username" Style="{StaticResource Muted}" />
                    <Entry Text="{Binding Username}" />
                    <Label Text="New password (leave empty to keep it)" Style="{StaticResource Muted}" />
                    <skeleton:CPasswordEntry Text="{Binding NewPassword}" ReturnType="Next"
                                             TextColor="{StaticResource TextPrimary}" PlaceholderColor="{StaticResource TextSecondary}" />
                    <skeleton:CPasswordEntry Text="{Binding ConfirmPassword}" Placeholder="Repeat the new password" ReturnType="Next"
                                             TextColor="{StaticResource TextPrimary}" PlaceholderColor="{StaticResource TextSecondary}" />
                    <Label Text="Current password, to confirm" Style="{StaticResource Muted}" />
                    <skeleton:CPasswordEntry Text="{Binding CurrentPassword}" ReturnType="Done"
                                             TextColor="{StaticResource TextPrimary}" PlaceholderColor="{StaticResource TextSecondary}">
                        <skeleton:CPasswordEntry.Behaviors>
                            <toolkit:EventToCommandBehavior EventName="Completed" Command="{Binding SaveCommand}" x:DataType="vm:AccountViewModel" />
                        </skeleton:CPasswordEntry.Behaviors>
                    </skeleton:CPasswordEntry>
                    <Button Text="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
