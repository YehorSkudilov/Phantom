<?xml version="1.0" encoding="utf-8" ?>
<views:TabView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Phantom.Views"
             xmlns:controls="clr-namespace:Phantom.Controls"
             xmlns:vm="clr-namespace:Phantom.ViewModels"
             x:Class="Phantom.Views.MorePage"
             x:DataType="vm:MoreViewModel">
    <ScrollView>
        <VerticalStackLayout Padding="16,18,16,108" Spacing="6">
            <!-- Who's signed in -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Padding="0,0,0,8">
                <Border WidthRequest="56" HeightRequest="56" StrokeShape="RoundRectangle 16" BackgroundColor="{Binding AvatarColor}">
                    <Label Text="{Binding Initial}" FontSize="24" FontFamily="OpenSansSemibold" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="{Binding Username}" Style="{StaticResource H2}" />
                    <Label Text="{Binding ServerText}" Style="{StaticResource Muted}" />
                </VerticalStackLayout>
            </Grid>

            <Label Text="ACCOUNT" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout>
                    <controls:MenuRow Glyph="manage_accounts" Text="Account" Command="{Binding NavigateCommand}" CommandParameter="AccountPage" />
                    <BoxView Style="{StaticResource Divider}" />
                    <controls:MenuRow Glyph="switch_account" Text="Switch profile" Command="{Binding SwitchProfileCommand}" />
                    <BoxView Style="{StaticResource Divider}" />
                    <controls:MenuRow Glyph="tv" Text="Sign in a TV" Command="{Binding SignInTvCommand}" />
                    <BoxView Style="{StaticResource Divider}" />
                    <controls:MenuRow Glyph="logout" Text="Sign out" Command="{Binding SignOutCommand}" ShowChevron="False" TextColor="{StaticResource Danger}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="APP" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout>
                    <controls:MenuRow Glyph="settings" Text="Settings" Command="{Binding NavigateCommand}" CommandParameter="SettingsPage" />
                    <BoxView Style="{StaticResource Divider}" IsVisible="{Binding IsAdmin}" />
                    <controls:MenuRow Glyph="dns" Text="Manage server" Command="{Binding NavigateCommand}" CommandParameter="AdminPage" IsVisible="{Binding IsAdmin}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</views:TabView>
