<?xml version="1.0" encoding="utf-8" ?>
<views:TabView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Phantom.Views"
             xmlns:controls="clr-namespace:Phantom.Controls"
             xmlns:vm="clr-namespace:Phantom.ViewModels"
             x:Class="Phantom.Views.MorePage"
             x:DataType="vm:MoreViewModel">
    <ScrollView>
        <VerticalStackLayout Padding="16,18,16,108" Spacing="6">
            <!-- Who's signed in -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Padding="0,0,0,8">
                <Border WidthRequest="56" HeightRequest="56" StrokeShape="RoundRectangle 16" BackgroundColor="{Binding AvatarColor}">
                    <Label Text="{Binding Initial}" FontSize="24" FontFamily="OpenSansSemibold" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <!-- The profile in use, and the account it belongs to -->
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="{Binding Username}" Style="{StaticResource H2}" />
                    <Label Text="{Binding AccountName, StringFormat='Account: {0}'}" Style="{StaticResource Muted}"
                           IsVisible="{Binding AccountName, Converter={StaticResource HasValue}}" />
                </VerticalStackLayout>
            </Grid>

            <Label Text="PROFILE" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}" Padding="0">
                <controls:MenuRow Glyph="switch_account" Text="Switch or manage profiles" Command="{Binding SwitchProfileCommand}" />
            </Border>

            <Label Text="ACCOUNT" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout>
                    <controls:MenuRow Glyph="manage_accounts" Text="Username and password" Command="{Binding NavigateCommand}" CommandParameter="AccountPage" />
                    <BoxView Style="{StaticResource Divider}" />
                    <controls:MenuRow Glyph="tv" Text="Sign in a TV" Command="{Binding SignInTvCommand}" />
                    <BoxView Style="{StaticResource Divider}" />
                    <controls:MenuRow Glyph="logout" Text="Sign out" Command="{Binding SignOutCommand}" ShowChevron="False" TextColor="{StaticResource Danger}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="APP" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}" Padding="0">
                <controls:MenuRow Glyph="tune" Text="Playback and subtitles" Command="{Binding NavigateCommand}" CommandParameter="SettingsPage" />
            </Border>

            <Label Text="SERVER" Style="{StaticResource SectionLabel}" IsVisible="{Binding IsAdmin}" />
            <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding IsAdmin}">
                <controls:MenuRow Glyph="dns" Text="Manage server" Command="{Binding NavigateCommand}" CommandParameter="AdminPage" />
            </Border>

            <Label Text="{Binding AppVersion}" Style="{StaticResource Muted}" FontSize="12" HorizontalOptions="Center" Margin="0,16,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</views:TabView>
