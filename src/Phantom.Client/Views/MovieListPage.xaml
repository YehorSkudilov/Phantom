<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Phantom.Controls"
             xmlns:vm="clr-namespace:Phantom.ViewModels"
             x:Class="Phantom.Views.MovieListPage"
             x:DataType="vm:MovieListViewModel"
             Title="{Binding Title}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Play all" IconImageSource="{controls:Icon playlist_play, Size=20}" Command="{Binding PlayAllCommand}" />
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="Auto,*">
        <Label Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="16,8" IsVisible="{Binding Subtitle, Converter={StaticResource HasValue}}" />
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
            <CollectionView x:Name="List" ItemsSource="{Binding Movies}" ItemTemplate="{StaticResource PosterCard}" SelectionMode="Single" SelectionChanged="OnSelected" Margin="12,0">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout x:Name="GridLayout" Orientation="Vertical" Span="3" HorizontalItemSpacing="10" VerticalItemSpacing="6" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <Label Text="Nothing here yet." Style="{StaticResource Muted}" HorizontalOptions="Center" Margin="0,48" />
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
