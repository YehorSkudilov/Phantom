<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Phantom.ViewModels"
             xmlns:dto="clr-namespace:Phantom.Shared;assembly=Phantom.Shared"
             x:Class="Phantom.Views.PlaylistsPage"
             x:DataType="vm:PlaylistsViewModel"
             Title="Playlists">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+ New" Command="{Binding CreateCommand}" />
    </ContentPage.ToolbarItems>
    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
        <CollectionView ItemsSource="{Binding Playlists}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="No playlists yet. Create one, or add movies from their detail page." Style="{StaticResource Muted}"
                       HorizontalTextAlignment="Center" Margin="32,48" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:PlaylistDto">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Delete" BackgroundColor="{StaticResource Danger}"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PlaylistsViewModel}}, Path=DeleteCommand, x:DataType=vm:PlaylistsViewModel}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Border Style="{StaticResource Card}" Margin="16,6">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PlaylistsViewModel}}, Path=OpenCommand, x:DataType=vm:PlaylistsViewModel}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Border WidthRequest="48" HeightRequest="48" StrokeShape="RoundRectangle 10" Background="{StaticResource BrandGradient}">
                                    <Label Text="≡" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="16" />
                                    <Label Text="{Binding Count, StringFormat='{0} movies'}" Style="{StaticResource Muted}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
