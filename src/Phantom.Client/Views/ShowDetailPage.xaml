<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Phantom.ViewModels"
             xmlns:controls="clr-namespace:Phantom.Controls"
             xmlns:dto="clr-namespace:Phantom.Shared;assembly=Phantom.Shared"
             x:Class="Phantom.Views.ShowDetailPage"
             x:DataType="vm:ShowDetailViewModel">

    <ContentPage.Resources>
        <!-- Shared by every episode row, rather than a new icon per row -->
        <FontImageSource x:Key="EpisodeWatchedIcon" Glyph="check_circle" FontFamily="RegularIcons" Size="24" Color="{StaticResource Primary}" />
        <FontImageSource x:Key="EpisodeUnwatchedIcon" Glyph="radio_button_unchecked" FontFamily="RegularIcons" Size="24" Color="{StaticResource TextSecondary}" />
        <FontImageSource x:Key="EpisodeServerIcon" Glyph="cloud_download" FontFamily="RegularIcons" Size="18" Color="{StaticResource TextPrimary}" />
        <!-- The small buttons under each episode -->
        <Style x:Key="EpisodeActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HeightRequest" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="ContentLayout" Value="Left,6" />
        </Style>
    </ContentPage.Resources>

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="0,0,0,32" Spacing="16">
                <!-- Backdrop + poster header, as on a movie's page -->
                <Grid HeightRequest="300">
                    <Image Source="{Binding Show.BackdropUrl, Converter={StaticResource Poster}}" Aspect="AspectFill" Opacity="0.7"
                           IsVisible="{Binding Show.BackdropUrl, Converter={StaticResource HasValue}}" />
                    <Image Source="{Binding Show.PosterUrl, Converter={StaticResource Poster}}" Aspect="AspectFill" Opacity="0.35"
                           IsVisible="{Binding Show.BackdropUrl, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                    <Grid Background="{StaticResource BackdropFade}" />
                    <Grid ColumnDefinitions="120,*" ColumnSpacing="16" Padding="16" VerticalOptions="End">
                        <Border StrokeShape="RoundRectangle 10" HeightRequest="180">
                            <Image Source="{Binding Show.PosterUrl, Converter={StaticResource Poster}}" Aspect="AspectFill" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="End" Spacing="6">
                            <Label Text="{Binding Show.Title}" Style="{StaticResource H1}" MaxLines="3" />
                            <Label Text="{Binding Meta}" Style="{StaticResource Muted}" />
                            <Label Text="{Binding GenreText}" Style="{StaticResource Muted}" />
                            <Label Text="{Binding Show.Network}" Style="{StaticResource Muted}" IsVisible="{Binding Show.Network, Converter={StaticResource HasValue}}" />
                        </VerticalStackLayout>
                    </Grid>
                </Grid>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

                <!-- Play the next episode; trailer, watchlist, watched, download, save on the server -->
                <VerticalStackLayout Padding="16,0" Spacing="10">
                    <!-- Play across the whole width, the trailer under it -->
                    <Button Text="{Binding PlayLabel}" Command="{Binding PlayCommand}" IsEnabled="{Binding CanPlay}" FontSize="16" HeightRequest="52"
                            ImageSource="{controls:Icon play_arrow, Color=White, Size=20}" ContentLayout="Left,8" />
                    <Button Text="Trailer" Style="{StaticResource SecondaryButton}" HeightRequest="46"
                            ImageSource="{controls:Icon smart_display, Size=20}" ContentLayout="Left,8"
                            Command="{Binding PlayTrailerCommand}" IsVisible="{Binding Show.TrailerUrl, Converter={StaticResource HasValue}}" />
                    <ProgressBar Progress="{Binding NextProgress}" IsVisible="{Binding NextProgress, Converter={StaticResource HasValue}}" />
                    <!-- As on a movie's page. Download and Save on server ask which season (or all of them). -->
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                        <controls:ActionTile Glyph="{Binding WatchlistGlyph}" Text="{Binding WatchlistLabel}" IsActive="{Binding IsOnWatchlist}"
                                             Command="{Binding ToggleWatchlistCommand}" />
                        <controls:ActionTile Grid.Column="1" Glyph="check_circle" Text="{Binding WatchedLabel}" IsActive="{Binding IsWatched}"
                                             Command="{Binding ToggleWatchedCommand}" />
                        <controls:ActionTile Grid.Row="1" Glyph="download" Text="Download" IsActive="{Binding HasDownloads}"
                                             Command="{Binding DownloadShowCommand}" />
                        <controls:ActionTile Grid.Row="1" Grid.Column="1" Glyph="cloud_download" Text="Save on server"
                                             Command="{Binding SaveShowOnServerCommand}" />
                    </Grid>
                </VerticalStackLayout>

                <!-- Overview -->
                <VerticalStackLayout Padding="16,0" Spacing="8">
                    <Label Text="{Binding Show.Overview}" LineHeight="1.3" />
                    <Label IsVisible="{Binding Creators, Converter={StaticResource HasValue}}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Created by " TextColor="{StaticResource TextSecondary}" />
                                <Span Text="{Binding Creators}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>

                <!-- Seasons and their episodes: the season (picked like a title), then "Episodes" and the season's
                     download buttons, then each episode with its own -->
                <VerticalStackLayout Padding="16,0" Spacing="10" IsVisible="{Binding Seasons.Count, Converter={StaticResource HasValue}}">
                    <!-- The season picker, shown as a heading with a drop-down arrow so it reads as something to tap -->
                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="2" HorizontalOptions="Start">
                        <Picker ItemsSource="{Binding Seasons}" SelectedItem="{Binding SelectedSeason}" MinimumWidthRequest="120"
                                ItemDisplayBinding="{Binding Title, x:DataType=dto:SeasonDto}" SemanticProperties.Description="Season"
                                FontFamily="OpenSansSemibold" FontSize="24" BackgroundColor="Transparent" />
                        <Image Grid.Column="1" Source="{controls:Icon expand_more, Size=28}" WidthRequest="28" HeightRequest="28"
                               VerticalOptions="Center" InputTransparent="True" />
                    </Grid>
                    <Label Text="Episodes" Style="{StaticResource H2}" />
                    <!-- The season: to this device, kept on the server, marked watched. Wraps onto two lines on a narrow phone
                         rather than cutting the labels short. -->
                    <FlexLayout Wrap="Wrap" Margin="-4,0">
                        <Button Text="Download season" Style="{StaticResource SecondaryButton}" FontSize="13" HeightRequest="42" Margin="4"
                                ImageSource="{controls:Icon download, Size=18}" ContentLayout="Left,6"
                                Command="{Binding DownloadSeasonCommand}" SemanticProperties.Description="Download this season to this device" />
                        <Button Text="Save season on server" Style="{StaticResource SecondaryButton}" FontSize="13" HeightRequest="42" Margin="4"
                                ImageSource="{controls:Icon cloud_download, Size=18}" ContentLayout="Left,6"
                                Command="{Binding SaveSeasonOnServerCommand}" SemanticProperties.Description="Save this season on the server" />
                        <Button Text="{Binding SeasonWatchedLabel}" Style="{StaticResource SecondaryButton}" FontSize="13" HeightRequest="42" Margin="4"
                                ImageSource="{controls:Icon check_circle, Size=18}" ContentLayout="Left,6"
                                Command="{Binding ToggleSeasonWatchedCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsSeasonWatched}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource PrimaryLight}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </FlexLayout>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Episodes}" Spacing="18" Margin="0,6,0,0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:EpisodeDto">
                                <!-- Not found yet: shown faded, and says so -->
                                <Grid ColumnDefinitions="128,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                                    <Grid.Triggers>
                                        <DataTrigger TargetType="Grid" Binding="{Binding Available}" Value="False">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </DataTrigger>
                                    </Grid.Triggers>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ShowDetailViewModel}}, Path=PlayEpisodeCommand, x:DataType=vm:ShowDetailViewModel}"
                                                              CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <Border StrokeShape="RoundRectangle 8" HeightRequest="76" VerticalOptions="Start" BackgroundColor="{StaticResource SurfaceRaised}">
                                        <Grid>
                                            <Image Source="{Binding StillUrl, Converter={StaticResource Poster}}" Aspect="AspectFill" />
                                            <ProgressBar Progress="{Binding Playback.ProgressPercent, Converter={StaticResource Percent}}" VerticalOptions="End"
                                                         IsVisible="{Binding Playback.PositionMs, Converter={StaticResource HasValue}}" />
                                        </Grid>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label Text="{Binding DisplayTitle}" FontFamily="OpenSansSemibold" MaxLines="2" LineBreakMode="TailTruncation" />
                                        <Label Style="{StaticResource Muted}" FontSize="12">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding RuntimeMinutes, Converter={StaticResource Minutes}}" />
                                                    <Span Text="{Binding AirDate, StringFormat='   {0:d MMM yyyy}'}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label Text="Not found yet" Style="{StaticResource Muted}" FontSize="12"
                                               IsVisible="{Binding Available, Converter={StaticResource Not}}" />
                                        <Label Text="{Binding Overview}" Style="{StaticResource Muted}" FontSize="12" MaxLines="2" LineBreakMode="TailTruncation"
                                               IsVisible="{Binding Overview, Converter={StaticResource HasValue}}" />
                                    </VerticalStackLayout>
                                    <!-- One button whose icon follows the state (two, one hidden, doubled every row's controls) -->
                                    <ImageButton Grid.Column="2" VerticalOptions="Center" Style="{StaticResource IconButton}"
                                                 Source="{StaticResource EpisodeUnwatchedIcon}"
                                                 Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ShowDetailViewModel}}, Path=ToggleEpisodeWatchedCommand, x:DataType=vm:ShowDetailViewModel}"
                                                 CommandParameter="{Binding .}"
                                                 SemanticProperties.Description="Not watched" ToolTipProperties.Text="Mark watched">
                                        <ImageButton.Triggers>
                                            <DataTrigger TargetType="ImageButton" Binding="{Binding Playback.Watched}" Value="True">
                                                <Setter Property="Source" Value="{StaticResource EpisodeWatchedIcon}" />
                                                <Setter Property="SemanticProperties.Description" Value="Watched" />
                                                <Setter Property="ToolTipProperties.Text" Value="Mark unwatched" />
                                            </DataTrigger>
                                        </ImageButton.Triggers>
                                    </ImageButton>
                                    <!-- Under the episode: just it, to this device (the label follows the download) or kept on the server -->
                                    <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="3" Spacing="8" IsVisible="{Binding Available}">
                                        <controls:EpisodeDownloadButton Style="{StaticResource EpisodeActionButton}"
                                                 EpisodeId="{Binding Id}"
                                                 Downloads="{Binding Source={RelativeSource AncestorType={x:Type vm:ShowDetailViewModel}}, Path=Downloads, x:DataType=vm:ShowDetailViewModel}"
                                                 Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ShowDetailViewModel}}, Path=DownloadEpisodeCommand, x:DataType=vm:ShowDetailViewModel}"
                                                 CommandParameter="{Binding .}" />
                                        <Button Text="Save on server" Style="{StaticResource EpisodeActionButton}"
                                                ImageSource="{StaticResource EpisodeServerIcon}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ShowDetailViewModel}}, Path=SaveEpisodeOnServerCommand, x:DataType=vm:ShowDetailViewModel}"
                                                CommandParameter="{Binding .}" SemanticProperties.Description="Save this episode on the server" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Cast -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding Show.Cast.Count, Converter={StaticResource HasValue}}">
                    <Label Text="Cast" Style="{StaticResource H2}" Margin="16,0" />
                    <CollectionView ItemsSource="{Binding Show.Cast}" HeightRequest="170" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.Header>
                            <BoxView WidthRequest="4" Color="Transparent" />
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dto:CastMemberDto">
                                <VerticalStackLayout WidthRequest="92" Spacing="4">
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ShowDetailViewModel}}, Path=OpenPersonCommand, x:DataType=vm:ShowDetailViewModel}"
                                                              CommandParameter="{Binding Name}" />
                                    </VerticalStackLayout.GestureRecognizers>
                                    <Border WidthRequest="84" HeightRequest="84" StrokeShape="RoundRectangle 42" BackgroundColor="{StaticResource SurfaceRaised}">
                                        <Image Source="{Binding ProfileUrl, Converter={StaticResource Poster}}" Aspect="AspectFill" />
                                    </Border>
                                    <Label Text="{Binding Name}" FontSize="12" HorizontalTextAlignment="Center" MaxLines="2" />
                                    <Label Text="{Binding Character}" FontSize="11" Style="{StaticResource Muted}" HorizontalTextAlignment="Center" MaxLines="1" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Genres as chips -->
                <FlexLayout BindableLayout.ItemsSource="{Binding Show.Genres}" Wrap="Wrap" Margin="12,0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button Text="{Binding .}" Style="{StaticResource SecondaryButton}" Margin="4" FontSize="12" Padding="12,4"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ShowDetailViewModel}}, Path=OpenGenreCommand, x:DataType=vm:ShowDetailViewModel}"
                                    CommandParameter="{Binding .}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
