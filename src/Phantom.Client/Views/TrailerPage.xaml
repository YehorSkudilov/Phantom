<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Phantom.Controls"
             x:Class="Phantom.Views.TrailerPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="Black">
    <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="Auto,*" Padding="8,8,16,8">
            <ImageButton Style="{StaticResource IconButton}" Source="{controls:Icon close, Color=White}" Clicked="OnClose"
                         SemanticProperties.Description="Close trailer" ToolTipProperties.Text="Close" />
            <Label x:Name="TitleLabel" Grid.Column="1" FontFamily="OpenSansSemibold" FontSize="16" TextColor="White"
                   VerticalOptions="Center" LineBreakMode="TailTruncation" />
        </Grid>
        <WebView x:Name="Player" Grid.Row="1" BackgroundColor="Black" />
    </Grid>
</ContentPage>
