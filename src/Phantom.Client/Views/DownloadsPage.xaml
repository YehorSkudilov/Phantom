<?xml version="1.0" encoding="utf-8" ?>
<views:TabView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Phantom.Controls"
             xmlns:views="clr-namespace:Phantom.Views"
             xmlns:parts="clr-namespace:Phantom.Views.Parts"
             xmlns:vm="clr-namespace:Phantom.ViewModels"
             xmlns:svc="clr-namespace:Phantom.Services"
             x:Class="Phantom.Views.DownloadsPage"
             x:DataType="vm:DownloadsViewModel">
    <Grid RowDefinitions="Auto,Auto,*">
        <Label Text="Downloads" Style="{StaticResource H1}" Margin="16,18,16,4" />
        <controls:TabStrip Grid.Row="1" Tabs="{Binding Tabs}" SelectedIndex="{Binding SelectedTab}" Margin="0,4,0,0" />

        <!-- On this device -->
        <Grid Grid.Row="2" RowDefinitions="Auto,*" IsVisible="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=0}">
        <Border Style="{StaticResource Card}" Margin="16,8">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <Label Text="On this device" Style="{StaticResource H2}" />
                <Label Grid.Row="1" Text="{Binding StorageText}" Style="{StaticResource Muted}" />
                <HorizontalStackLayout Grid.Column="1" Grid.RowSpan="2" Spacing="6" VerticalOptions="Center">
                    <Label Text="Wi-Fi only" Style="{StaticResource Muted}" VerticalOptions="Center" />
                    <Switch IsToggled="{Binding WifiOnly}" />
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- Empty state outside the list: on Windows a CollectionView with a footer never shows its EmptyView. -->
        <VerticalStackLayout Grid.Row="1" Spacing="8" Margin="32,48" HorizontalOptions="Center"
                             IsVisible="{Binding Items.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}">
            <Image Source="logo_mark.png" HeightRequest="56" Opacity="0.6" />
            <Label Text="No downloads yet" Style="{StaticResource H2}" HorizontalOptions="Center" />
            <Label Text="Open a movie and tap Download to watch it without a connection." Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
        <CollectionView ItemsSource="{Binding Items}" SelectionMode="None">
            <CollectionView.Footer>
                <BoxView HeightRequest="{x:Static views:TabView.NavBarInset}" Color="Transparent" />
            </CollectionView.Footer>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="svc:OfflineDownload">
                    <Border Style="{StaticResource Card}" Margin="16,5" Padding="10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadsViewModel}}, Path=OpenCommand, x:DataType=vm:DownloadsViewModel}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="12">
                            <Border StrokeShape="RoundRectangle 6" HeightRequest="84">
                                <Image Source="{Binding PosterSource}" Aspect="AspectFill" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="15" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Subtitle}" FontSize="13" LineBreakMode="TailTruncation"
                                       IsVisible="{Binding Subtitle, Converter={StaticResource HasValue}}" />
                                <Label Text="{Binding StatusText}" FontSize="12" TextColor="{StaticResource PrimaryLight}" />
                                <ProgressBar Progress="{Binding Progress}" IsVisible="{Binding IsComplete, Converter={StaticResource Not}}" Margin="0,2" />
                                <Label Text="{Binding SizeText}" Style="{StaticResource Muted}" FontSize="12"
                                       IsVisible="{Binding SizeText, Converter={StaticResource HasValue}}" />
                                <Label Text="{Binding Error}" TextColor="{StaticResource Danger}" FontSize="11" MaxLines="2"
                                       IsVisible="{Binding Error, Converter={StaticResource HasValue}}" />
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
                                <ImageButton Style="{StaticResource IconButton}" Source="{controls:Icon play_arrow}" IsVisible="{Binding IsComplete}"
                                             SemanticProperties.Description="Play" ToolTipProperties.Text="Play"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadsViewModel}}, Path=PlayCommand, x:DataType=vm:DownloadsViewModel}"
                                             CommandParameter="{Binding .}" />
                                <ImageButton Style="{StaticResource IconButton}" Source="{controls:Icon pause}" IsVisible="{Binding CanPause}"
                                             SemanticProperties.Description="Pause" ToolTipProperties.Text="Pause"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadsViewModel}}, Path=PauseCommand, x:DataType=vm:DownloadsViewModel}"
                                             CommandParameter="{Binding .}" />
                                <ImageButton Style="{StaticResource IconButton}" Source="{controls:Icon download}" IsVisible="{Binding CanResume}"
                                             SemanticProperties.Description="Resume" ToolTipProperties.Text="Resume"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadsViewModel}}, Path=ResumeCommand, x:DataType=vm:DownloadsViewModel}"
                                             CommandParameter="{Binding .}" />
                                <ImageButton Style="{StaticResource IconButton}" Source="{controls:Icon close}" IsVisible="{Binding IsComplete, Converter={StaticResource Not}}"
                                             SemanticProperties.Description="Cancel download" ToolTipProperties.Text="Cancel download"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadsViewModel}}, Path=DeleteCommand, x:DataType=vm:DownloadsViewModel}"
                                             CommandParameter="{Binding .}" />
                                <ImageButton Style="{StaticResource IconButton}" Source="{controls:Icon delete, Outlined=True}" IsVisible="{Binding IsComplete}"
                                             SemanticProperties.Description="Delete from this device" ToolTipProperties.Text="Delete from this device"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadsViewModel}}, Path=DeleteCommand, x:DataType=vm:DownloadsViewModel}"
                                             CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </RefreshView>
        </Grid>

        <!-- On the server -->
        <parts:ServerDownloadsView Grid.Row="2" BindingContext="{Binding Server}"
                                   IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadsViewModel}}, Path=SelectedTab, Converter={StaticResource Equals}, ConverterParameter=1, x:DataType=vm:DownloadsViewModel}" />
    </Grid>
</views:TabView>
