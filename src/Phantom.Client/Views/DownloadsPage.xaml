<?xml version="1.0" encoding="utf-8" ?>
<views:TabView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Phantom.Controls"
             xmlns:views="clr-namespace:Phantom.Views"
             xmlns:vm="clr-namespace:Phantom.ViewModels"
             xmlns:svc="clr-namespace:Phantom.Services"
             x:Class="Phantom.Views.DownloadsPage"
             x:DataType="vm:DownloadsViewModel">
    <Grid RowDefinitions="Auto,Auto,*">
        <Label Text="Downloads" Style="{StaticResource H1}" Margin="16,18,16,4" />
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="16,8">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <Label Text="On this device" Style="{StaticResource H2}" />
                <Label Grid.Row="1" Text="{Binding StorageText}" Style="{StaticResource Muted}" />
                <HorizontalStackLayout Grid.Column="1" Grid.RowSpan="2" Spacing="6" VerticalOptions="Center">
                    <Label Text="Wi-Fi only" Style="{StaticResource Muted}" VerticalOptions="Center" />
                    <Switch IsToggled="{Binding WifiOnly}" />
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Items}" SelectionMode="None">
            <CollectionView.Footer>
                <BoxView HeightRequest="{x:Static views:TabView.NavBarInset}" Color="Transparent" />
            </CollectionView.Footer>
            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="8" Margin="32,48" HorizontalOptions="Center">
                    <Image Source="logo_mark.png" HeightRequest="56" Opacity="0.6" />
                    <Label Text="No downloads yet" Style="{StaticResource H2}" HorizontalOptions="Center" />
                    <Label Text="Open a movie and tap Download to watch it without a connection." Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="svc:OfflineDownload">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Delete" BackgroundColor="{StaticResource Danger}"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadsViewModel}}, Path=DeleteCommand, x:DataType=vm:DownloadsViewModel}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Grid ColumnDefinitions="60,*,Auto" ColumnSpacing="12" Padding="16,8" BackgroundColor="{StaticResource Background}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadsViewModel}}, Path=PlayCommand, x:DataType=vm:DownloadsViewModel}"
                                                      CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <Border StrokeShape="RoundRectangle 6" HeightRequest="88">
                                <Image Source="{Binding PosterSource}" Aspect="AspectFill" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" LineBreakMode="TailTruncation" />
                                <Label Style="{StaticResource Muted}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Status}" />
                                            <Span Text="  ·  " />
                                            <Span Text="{Binding DownloadedBytes, Converter={StaticResource Bytes}}" />
                                            <Span Text=" / " />
                                            <Span Text="{Binding TotalBytes, Converter={StaticResource Bytes}}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <ProgressBar Progress="{Binding Progress}" IsVisible="{Binding IsComplete, Converter={StaticResource Not}}" />
                                <Label Text="{Binding BytesPerSecond, Converter={StaticResource Bytes}, ConverterParameter=rate}" Style="{StaticResource Muted}" FontSize="11"
                                       IsVisible="{Binding BytesPerSecond, Converter={StaticResource HasValue}}" />
                                <Label Text="{Binding Error}" TextColor="{StaticResource Danger}" FontSize="11" IsVisible="{Binding Error, Converter={StaticResource HasValue}}" />
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="2" Spacing="0">
                                <ImageButton Style="{StaticResource IconButton}" Source="{controls:Icon pause_circle, Outlined=True}" IsVisible="{Binding IsComplete, Converter={StaticResource Not}}"
                                        ToolTipProperties.Text="Pause or resume"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadsViewModel}}, Path=ToggleCommand, x:DataType=vm:DownloadsViewModel}"
                                        CommandParameter="{Binding .}" SemanticProperties.Description="Pause or resume" />
                                <ImageButton Style="{StaticResource IconButton}" Source="{controls:Icon info, Outlined=True}" ToolTipProperties.Text="Details"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadsViewModel}}, Path=OpenCommand, x:DataType=vm:DownloadsViewModel}"
                                        CommandParameter="{Binding .}" SemanticProperties.Description="Details" />
                            </HorizontalStackLayout>
                        </Grid>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</views:TabView>
