<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Phantom.ViewModels"
             x:Class="Phantom.Views.ConnectPage"
             x:DataType="vm:ConnectViewModel">
    <Grid>
        <!-- Soft brand glow behind the sign-in card -->
        <Ellipse Fill="{StaticResource BrandGradient}" Opacity="0.18" WidthRequest="520" HeightRequest="520"
                 HorizontalOptions="Center" VerticalOptions="Start" Margin="0,-220,0,0" />
        <ScrollView>
            <VerticalStackLayout Padding="28,72,28,28" Spacing="18" MaximumWidthRequest="440">
                <Image Source="logo_mark.png" HeightRequest="88" />
                <Image Source="logo_wordmark.png" HeightRequest="40" />
                <Label Text="Your movies, streamed from the swarm." Style="{StaticResource Muted}" HorizontalOptions="Center" />

                <Border Style="{StaticResource Card}" Padding="18" Margin="0,16,0,0">
                    <VerticalStackLayout Spacing="12">
                        <!-- Step 1: reach the server (connects automatically; Retry if it was unreachable) -->
                        <VerticalStackLayout Spacing="12" IsVisible="{Binding IsConnected, Converter={StaticResource Not}}">
                            <Label Text="Connecting to Phantom…" Style="{StaticResource H2}" />
                            <Button Text="Retry" Command="{Binding ConnectCommand}" IsEnabled="{Binding IsNotBusy}"
                                    IsVisible="{Binding ErrorMessage, Converter={StaticResource HasValue}}" />
                        </VerticalStackLayout>

                        <!-- Step 2: sign in (or create the owner account on first run) -->
                        <VerticalStackLayout Spacing="12" IsVisible="{Binding IsConnected}">
                            <Label Text="{Binding ServerName}" Style="{StaticResource Muted}" />
                            <Label Text="Create the owner account" Style="{StaticResource H2}" IsVisible="{Binding IsFirstRun}" />
                            <Label Text="This server is new. The first account becomes the administrator." Style="{StaticResource Muted}" IsVisible="{Binding IsFirstRun}" />
                            <Label Text="Sign in" Style="{StaticResource H2}" IsVisible="{Binding IsFirstRun, Converter={StaticResource Not}}" />
                            <Entry Text="{Binding Username}" Placeholder="Username" SemanticProperties.Description="Username" />
                            <Entry Text="{Binding Password}" Placeholder="Password" IsPassword="True"
                                   ReturnCommand="{Binding SignInCommand}" SemanticProperties.Description="Password" />
                            <Button Text="Continue" Command="{Binding SignInCommand}" IsEnabled="{Binding IsNotBusy}" />
                        </VerticalStackLayout>

                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                        <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"
                               IsVisible="{Binding ErrorMessage, Converter={StaticResource HasValue}}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
