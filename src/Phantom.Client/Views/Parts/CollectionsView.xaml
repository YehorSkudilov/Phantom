<?xml version="1.0" encoding="utf-8" ?>
<!-- TMDB collections (franchises), in the My Library tab. Tapping one opens its movies. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Phantom.ViewModels"
             xmlns:views="clr-namespace:Phantom.Views"
             xmlns:controls="clr-namespace:Phantom.Controls"
             xmlns:dto="clr-namespace:Phantom.Shared;assembly=Phantom.Shared"
             x:Class="Phantom.Views.Parts.CollectionsView"
             x:DataType="vm:CollectionsViewModel">
    <Grid>
        <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Collections}" SelectionMode="None" Margin="12,8">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout x:Name="GridLayout" Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.Footer>
                    <BoxView HeightRequest="{x:Static views:TabView.NavBarInset}" Color="Transparent" />
                </CollectionView.Footer>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:CollectionDto">
                        <VerticalStackLayout Spacing="4">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CollectionsViewModel}}, Path=OpenCommand, x:DataType=vm:CollectionsViewModel}"
                                                      CommandParameter="{Binding .}" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Border StrokeShape="RoundRectangle 10" HeightRequest="230" BackgroundColor="{StaticResource Surface}">
                                <Image Source="{Binding PosterUrl, Converter={StaticResource Poster}}" Aspect="AspectFill" />
                            </Border>
                            <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding Count, StringFormat='{0} movies'}" Style="{StaticResource Muted}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        <controls:StateView Skeleton="Grid" HasContent="{Binding Collections.Count, Converter={StaticResource HasValue}}"
                            IsLoading="{Binding IsBusy}" HasLoaded="{Binding HasLoaded}" IsOffline="{Binding IsOffline}"
                            RetryCommand="{Binding LoadCommand}" Glyph="collections_bookmark" Title="No collections yet"
                            Message="Film series (every Bond, every Pixar...) gather here on their own once the server has fetched movie details." />
    </Grid>
</ContentView>
