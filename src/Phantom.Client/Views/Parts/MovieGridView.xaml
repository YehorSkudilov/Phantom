<?xml version="1.0" encoding="utf-8" ?>
<!-- A grid of posters for a MovieListViewModel: the watchlist, recently watched or one collection. Used by the Library
     tab's sub-tabs and by MovieListPage. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Phantom.ViewModels"
             xmlns:views="clr-namespace:Phantom.Views"
             x:Class="Phantom.Views.Parts.MovieGridView"
             x:DataType="vm:MovieListViewModel">
    <Grid RowDefinitions="Auto,*">
        <Label Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="16,8" IsVisible="{Binding Subtitle, Converter={StaticResource HasValue}}" />
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Movies}" ItemTemplate="{StaticResource PosterCard}" SelectionMode="Single"
                            SelectionChanged="OnSelected" Margin="12,0">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout x:Name="GridLayout" Orientation="Vertical" Span="3" HorizontalItemSpacing="10" VerticalItemSpacing="6" />
                </CollectionView.ItemsLayout>
                <CollectionView.Footer>
                    <BoxView HeightRequest="{x:Static views:TabView.NavBarInset}" Color="Transparent" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>
        <Label Grid.Row="1" Text="{Binding EmptyText}" Style="{StaticResource Muted}" HorizontalTextAlignment="Center" Margin="32,48"
               VerticalOptions="Start" IsVisible="{Binding IsEmpty}" />
    </Grid>
</ContentView>
