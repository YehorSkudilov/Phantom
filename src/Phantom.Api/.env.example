# All settings of the Phantom API. Copy to .env (git-ignored) next to this file: docker-compose.yml passes it to the
# container, and the API loads it itself when run with dotnet run / the IDE. On the server the Publish API workflow
# writes .env from the repository's GitHub variables and secrets. "__" separates sections (Phantom__TmdbApiKey =
# Phantom:TmdbApiKey).

# Logging
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
Logging__LogLevel__Microsoft.EntityFrameworkCore=Warning
Logging__LogLevel__System.Net.Http.HttpClient=Warning

# Where the database, torrent cache, permanent downloads and (if JwtSigningKey is empty) the generated JWT key live.
# docker-compose.yml points the container at its /data volume.
Phantom__DataDirectory=data

# JWT signing key (at least 32 characters). Empty generates one under DataDirectory on first start.
Phantom__JwtSigningKey=
Phantom__TokenLifetimeDays=30

# Let anyone create an account after the first (owner) account exists
Phantom__AllowRegistration=false

# TMDB v3 API key for posters, cast, trailers, ratings and collections; empty turns metadata off.
Phantom__TmdbApiKey=

# Transcoder (installed in the Docker image); a missing binary just turns transcoding off.
Phantom__FfmpegPath=ffmpeg

# BitTorrent/DHT listen port inside the container (docker-compose.yml publishes TORRENT_PORT to it)
Phantom__TorrentListenPort=55125

# Add the public-domain Internet Archive source on first run
Phantom__SeedDefaultSources=true

# Swagger UI basic auth
SwaggerAuth__Username=admin
SwaggerAuth__Password=

# Comma-separated CIDRs of reverse proxies whose X-Forwarded-* headers are trusted (besides loopback)
ReverseProxy__KnownNetworks=

# Host ports (consumed by docker-compose.yml): the API container, and BitTorrent (TCP and UDP; forward it on the
# router for better speeds)
API_PORT=8080
TORRENT_PORT=55125
